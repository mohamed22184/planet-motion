---
// علامة Planet Motion. currentColor عشان تاخد لون المكان اللي فيه.
interface Props { size?: number; class?: string; }
const { size = 16, class: cls = '' } = Astro.props;
---
<svg
  class={cls}
  width={size} height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="12" cy="12" r="5.6" fill="currentColor" />
  <ellipse cx="12" cy="12" rx="10" ry="3.5" transform="rotate(-22 12 12)"
           fill="none" stroke="currentColor" stroke-width="1.6" />
</svg>
