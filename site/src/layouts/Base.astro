---
import fs from 'node:fs';
import path from 'node:path';
import { ClientRouter } from 'astro:transitions';
import { sections } from '../data/work';
import Mark from '../components/Mark.astro';
import '../styles/global.css';

// نفس منطق الكروت: الكارت اللي ملوش لوب مابياخدش عنصر فيديو أصلًا
const loopsDir = path.join(process.cwd(), 'public', 'loops');
const loopFiles = new Set(fs.existsSync(loopsDir) ? fs.readdirSync(loopsDir) : []);
const firstLoop = (id: string) => {
  for (const ext of ['mp4', 'webm']) {
    if (loopFiles.has(`${id}-1.${ext}`)) return `/loops/${id}-1.${ext}`;
  }
  return '';
};
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- لازم يتنفّذ قبل أول رسم: لو الزائر شاف البريلودر في الجلسة دي،
         أو مفعّل تقليل الحركة، الصفحة تفتح على طول من غير أي ومضة. -->
    <script is:inline>
      (function () {
        var skip = false;
        try { skip = !!sessionStorage.getItem('pm-intro'); } catch (e) {}
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) skip = true;
        document.documentElement.classList.add(skip ? 'intro-off' : 'intro-on');
      })();
    </script>
    <!-- قياس: بيسجّل أزمنة الفريمات من أول فريم في الصفحة ولحظة
         شيل البريلودر. ديف بس — مش موجود في البيلد. -->
    {import.meta.env.DEV && (
      <script is:inline set:html={`
        window.__t0 = performance.now(); window.__frames = [];
        (function(){ var l = performance.now();
          (function L(){ var n = performance.now();
            window.__frames.push(n - l); l = n; requestAnimationFrame(L); })(); })();
        // لازم نتأكد إننا شوفنا البريلودر الأول: وإلا أول mutation
        // وقت تحليل الصفحة (والـbody لسه مش موجود) بتسجّل 0
        var seen = false;
        new MutationObserver(function(){
          if (document.querySelector('#intro')) { seen = true; return; }
          if (seen && !window.__introEnd)
            window.__introEnd = performance.now() - window.__t0;
        }).observe(document.documentElement, { childList: true, subtree: true });
      `} />
    )}
    <title>{title}</title>

    <!-- الخطوط متنزّلة على الموقع (شوف src/styles/fonts.css).
         الـpreload للاتنين اللي بيظهروا في أول فريم بس — أي خط زيادة
         هنا بيزاحم الموارد المهمة بدل ما يسرّعها. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/fonts/cabinet-grotesk-700.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/fonts/geist-mono-latin.woff2" />

    <!-- من غير جافاسكريبت مفيش حاجة تشيل البريلودر، فكان هيغطي الموقع -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo/planet-blender.png" />
    <meta name="theme-color" content="#140F0D" />

    <noscript><style>.intro { display: none !important; }</style></noscript>

    <ClientRouter />
  </head>
  <body>
    <!-- بيفضل في مكانه وقت تبديل الصفحة، وإلا كان هيختفي في نص المسح -->
    <a class="skip" href="#main">Skip to content</a>

    <!-- ===== المينيو =====
         شاشة كاملة، والهوفر على القسم بيشغّل لوب منه في الخلفية.
         موجودة في الـlayout فبتشتغل في كل الصفحات — وده بيحل كمان
         إن الصفحات الداخلية مكنش ليها طريق غير الرجوع للرئيسية. -->
    <button class="menu-btn mono" id="menuBtn" type="button"
            aria-expanded="false" aria-controls="menu">
      <span class="menu-btn-t">Menu</span>
      <span class="menu-bars" aria-hidden="true"><i></i><i></i></span>
    </button>

    <div class="menu" id="menu" aria-hidden="true">
      <video class="menu-bg" id="menuBg" muted loop playsinline preload="none"></video>
      <div class="menu-veil"></div>

      <nav class="menu-nav" aria-label="Sections">
        <ul>
          {sections.map((sec, i) => (
            <li>
              <a
                href={sec.id === 'about' || sec.id === 'contact' ? `/${sec.id}` : `/#${sec.id}`}
                data-sec={sec.id}
                data-loop={firstLoop(sec.id)}
              >
                <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
                <span class="menu-line"><span>{sec.label}</span></span>
                <span class="mono m">{sec.meta}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="menu-foot mono">
        <span><Mark size={15} class="mk" /> Planet Motion · Available</span>
        <a href="mailto:hello@planetmotion.studio">hello@planetmotion.studio</a>
      </div>
    </div>
    <div class="wipe" id="wipe" aria-hidden="true" transition:persist="wipe"></div>

    <div class="intro" id="intro" aria-hidden="true">
      <div class="intro-stage">
        <!-- علامة الكوكب بترسم نفسها. الكاميرا هي اللي بتلف حوالين
             الكوكب: الحزام بيبدأ شبه خط (شايفينه من مستوى مداره)
             وبيتفتّح لحد ميله الطبيعي — والنص البعيد منه مخفي ورا
             الكرة، فالترتيب نفسه بيدي عمق. مفيش فلتر SVG على حاجة
             بتتحرك؛ الكل تدرّجات + تمويه CSS على الكرة بس. -->
        <svg class="intro-planet" viewBox="-100 -100 200 200"
             aria-hidden="true" focusable="false">
          <defs>
            <clipPath id="ip-globe"><circle r="42" /></clipPath>
            <radialGradient id="ip-body" cx="34%" cy="26%" r="78%">
              <stop offset="0%"   stop-color="#B06A3C" />
              <stop offset="42%"  stop-color="#6E3C24" />
              <stop offset="78%"  stop-color="#3A2018" />
              <stop offset="100%" stop-color="#180F0C" />
            </radialGradient>
            <radialGradient id="ip-shade" cx="32%" cy="24%" r="82%">
              <stop offset="0%"   stop-color="#FFFFFF" stop-opacity=".10" />
              <stop offset="46%"  stop-color="#140F0D" stop-opacity="0" />
              <stop offset="100%" stop-color="#0B0706" stop-opacity=".88" />
            </radialGradient>
            <linearGradient id="ip-rim" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%"   stop-color="#E8A06A" stop-opacity=".75" />
              <stop offset="45%"  stop-color="#E8A06A" stop-opacity="0" />
            </linearGradient>
          </defs>

          <!-- النص البعيد من الحزام — بيتخفي ورا الكرة -->
          <g class="ip-tilt"><path class="ip-belt" id="ipFar" d="M -76 0 A 76 27 0 0 1 76 0" /></g>

          <g class="ip-globe" id="ipGlobe">
            <g clip-path="url(#ip-globe)" transform="rotate(-22)">
              <circle r="42" fill="url(#ip-body)" />
              <g opacity=".5">
                <ellipse cy="-24" rx="42" ry="6"   fill="#2A1712" />
                <ellipse cy="-9"  rx="42" ry="4"   fill="#C2561B" />
                <ellipse cy="4"   rx="42" ry="7"   fill="#2A1712" />
                <ellipse cy="20"  rx="42" ry="5"   fill="#3E2723" />
              </g>
              <ellipse cx="-12" cy="9" rx="9" ry="4.5" fill="#E65100" opacity=".8" />
              <circle r="42" fill="url(#ip-shade)" />
            </g>
            <circle r="41.2" fill="none" stroke="url(#ip-rim)" stroke-width="1.6" />
          </g>

          <!-- النص القريب فوق الكرة، ومعاه رأس تشغيل بيلفّ المدار -->
          <g class="ip-tilt">
            <path class="ip-belt" id="ipNear" d="M 76 0 A 76 27 0 0 1 -76 0" />
            <path class="ip-play" id="ipPlay" d="M 76 0 A 76 27 0 0 1 -76 0" />
          </g>
        </svg>

        <span class="intro-name mono" id="introName">Planet Motion</span>
      </div>
      <span class="intro-tc mono" id="introTc">00:00:00:00</span>
      <span class="intro-bar" id="introBar"></span>
    </div>

    <slot />
    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // مع راوتر Astro، سكربتات الموديول بتتنفّذ مرة واحدة بس. فأي تهيئة
      // لازم تتنادى على astro:page-load، وأي حاجة بتسجّل نفسها (مستمعين،
      // ScrollTrigger، Lenis) لازم تتفكّ على astro:before-swap — وإلا
      // بتتراكم مع كل تنقّل.
      let ac: AbortController | null = null;
      let lenis: any = null;
      let ticker: ((t: number) => void) | null = null;

      const teardown = () => {
        ac?.abort(); ac = null;
        ScrollTrigger.getAll().forEach((t) => t.kill());
        if (ticker) { gsap.ticker.remove(ticker); ticker = null; }
        lenis?.destroy(); lenis = null;
      };

      const init = () => {
        teardown();
        ac = new AbortController();
        const signal = ac.signal;

        gsap.registerPlugin(ScrollTrigger);
        // SplitText متسطّب وجاهز — هنستورده لما نحتاج تقسيم سطور تلقائي
  
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  
        // ===== البريلودر =====
        // مربوط بالتحميل الحقيقي، مش تأخير وهمي: بيستنى الخطوط تجهز
        // (هي اللي بتغيّر شكل الصفحة) وبعد أول رسمتين.
        // أرضية 580ms عشان مايومضش، وسقف 1400ms عشان مايحبسش الزائر لو
        // الشبكة وحشة. مع حركة الخروج (650ms) الإجمالي بيقع تحت 1.3 ثانية.
        const introEl = document.querySelector<HTMLElement>('#intro');
  
        const runIntro = async () => {
          // البوابة على sessionStorage مش على كلاس الـhtml: الكلاس
          // بيتحط من سكربت الـhead اللي بيتنفّذ في التحميل الكامل بس،
          // لكن راوتر Astro بيعيد تركيب الـbody — فالبريلودر كان
          // بيترسم من أول في كل تنقّل داخلي.
          let seen = false;
          try { seen = !!sessionStorage.getItem('pm-intro'); } catch {}
          if (!introEl || seen || document.documentElement.classList.contains('intro-off')) {
            // بنشيله من الصفحة مش بنعتمد على display:none — لو الـCSS
            // اتأخر أو فشل، العنصر كان هيغطي المحتوى
            introEl?.remove();
            document.documentElement.classList.remove('intro-on');
            return;
          }
          try { sessionStorage.setItem('pm-intro', '1'); } catch {}
  
          const FLOOR = 580, CEIL = 1400;
          const t0 = performance.now();
          const tcEl = document.querySelector<HTMLElement>('#introTc')!;
          const barEl = document.querySelector<HTMLElement>('#introBar')!;
          const pad = (n: number) => String(Math.floor(n)).padStart(2, '0');
  
          // ===== رسم علامة الكوكب =====
          // مش كتابة الاسم: الكاميرا بتلفّ حوالين الكوكب والحزام
          // بيتفتّح من مستوى مداره. العمق هنا من تلات حاجات مع بعض:
          // الحجب (نص الحزام البعيد ورا الكرة)، اختصار المنظور
          // (scaleY بيكبر = الكاميرا بتميل)، وعمق الميدان (الكرة
          // بتوضح من تمويه). الميل على مجموعات الحزام مش على الـSVG
          // كله عشان الكرة تفضل دايرة — الكرة مابتختصرش مع الميل.
          const tilts = gsap.utils.toArray<SVGGElement>('.ip-tilt');
          const far = document.querySelector<SVGPathElement>('#ipFar')!;
          const near = document.querySelector<SVGPathElement>('#ipNear')!;
          const play = document.querySelector<SVGPathElement>('#ipPlay')!;
          const L = near.getTotalLength();

          // vector-effect في الـCSS بيمنع الـstroke من إنه يرقّ مع scaleY
          gsap.set(tilts, { svgOrigin: '0 0', scaleY: 0.06, rotation: -7 });
          gsap.set([far, near], { strokeDasharray: L, strokeDashoffset: L });
          gsap.set(play, { strokeDasharray: `14 ${L}`, strokeDashoffset: L });
          gsap.set('#ipGlobe', { svgOrigin: '0 0', scale: 0.84, opacity: 0, filter: 'blur(10px)' });
          gsap.set('#introName', { opacity: 0, y: 8 });

          const draw = gsap.timeline();
          draw
            .to('#ipGlobe', { scale: 1, opacity: 1, filter: 'blur(0px)', duration: 0.58, ease: 'expo.out' }, 0)
            .to(tilts, { scaleY: 1, rotation: -22, duration: 0.62, ease: 'expo.out' }, 0.02)
            .to(far, { strokeDashoffset: 0, duration: 0.44, ease: 'power2.out' }, 0.04)
            .to(near, { strokeDashoffset: 0, duration: 0.44, ease: 'power2.out' }, 0.12)
            // رأس التشغيل: شرطة أكسنت واحدة بتلفّ المدار — نفس
            // مفردة السكرابر، وحجمها يخليها تحت سقف الـ3%
            .to(play, { strokeDashoffset: -14, duration: 0.46, ease: 'power1.inOut' }, 0.08)
            .to('#introName', { opacity: 1, y: 0, duration: 0.36, ease: 'power3.out' }, 0.2);

          // في الديف بس: منفذ للرسمة عشان نقدر نوقّفها ونقيسها فريم
          // بفريم. بيتشال في البيلد.
          if (import.meta.env.DEV) (window as any).__introTl = draw;
  
          // التايمكود بيعدّ بالوقت الحقيقي على 25 فريم/ثانية — زي قارئ
          // تايمكود حقيقي، مش نسبة تحميل متنكّرة في شكل تايمكود.
          let raf = 0;
          const tick = () => {
            const t = (performance.now() - t0) / 1000;
            tcEl.textContent = `00:00:${pad(t)}:${pad((t * 25) % 25)}`;
            barEl.style.setProperty('--p', `${Math.min((t * 1000) / CEIL, 1) * 100}%`);
            raf = requestAnimationFrame(tick);
          };
          tick();
  
          const ready = Promise.all([
            document.fonts?.ready ?? Promise.resolve(),
            new Promise<void>((r) => requestAnimationFrame(() => requestAnimationFrame(() => r()))),
          ]);
          const ceiling = new Promise<void>((r) => setTimeout(r, CEIL));
          await Promise.race([ready, ceiling]);
  
          const left = FLOOR - (performance.now() - t0);
          if (left > 0) await new Promise((r) => setTimeout(r, left));
  
          // الرسمة لازم تكمل قبل الخروج — لولا كده الخطوط اللي بتجهز
          // بدري بتخلي المسح يقطع العلامة في نص ما هي بترسم
          await draw.then();
          cancelAnimationFrame(raf);
  
          await gsap
            .timeline()
            .to('.intro-stage, .intro-tc, .intro-bar', { opacity: 0, duration: 0.18, ease: 'power2.in' })
            // المسح لفوق وخط الأكسنت هو الحافة القُدّام
            .to(introEl, { yPercent: -100, duration: 0.48, ease: 'power3.inOut' }, 0.1)
            .then();
  
          introEl.remove();
          document.documentElement.classList.remove('intro-on');
        };
  
        // الفشل هنا معناه إن الزائر يفضل مقفول وراه — نشيله مهما حصل
        runIntro().catch(() => {
          introEl?.remove();
          document.documentElement.classList.remove('intro-on');
        });
  
        if (!reduced) {
          // Lenis مربوط بـ gsap.ticker — loop واحد بس، مفيش تضارب.
          // بيتخزّن برّه init عشان teardown يقدر يفكّه قبل التنقّل.
          lenis = new Lenis({ duration: 1.1, smoothWheel: true });
          // الصفحات محتاجة تحرّك السكرول بنفسها (كليك على كارت، أسهم الكيبورد)
          (window as any).__lenis = lenis;
          lenis.on('scroll', ScrollTrigger.update);
          ticker = (t: number) => lenis.raf(t * 1000);
          gsap.ticker.add(ticker);
          gsap.ticker.lagSmoothing(0);
        }
  
        // الـeasing الأساسي — نفس القيمة اللي في tokens.css
        const EASE = 'power4.out';
        const DUR = reduced ? 0 : 0.8;
  
        // دخول التايب بالـmask سطر سطر.
        // الـset مقصودة: GSAP بيقرا translateY(105%) اللي في الـCSS كـ y بالبكسل،
        // فلو حطينا yPercent فوقه بيتجمعوا والسطر يفضل مخفي. عشان كده بنصفّر y
        // ونسجّل البداية كـ yPercent بس. وبنستخدم to مش fromTo عشان immediateRender
        // مايرجّعش العناصر لنقطة البداية مع كل ScrollTrigger.refresh().
        gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
          const lines = el.querySelectorAll('.line-mask > span');
          gsap.set(lines, { y: 0, yPercent: 105 });
          gsap.to(lines, {
            yPercent: 0,
            duration: DUR,
            ease: EASE,
            stagger: 0.08,
            scrollTrigger: { trigger: el, start: 'top 85%', once: true },
          });
        });
  
        // stagger لكروت الجريد
        gsap.utils.toArray<HTMLElement>('[data-stagger]').forEach((grid) => {
          const items = grid.children;
          gsap.set(items, { y: reduced ? 0 : 40, opacity: 0 });
          gsap.to(items, {
            y: 0,
            opacity: 1,
            duration: DUR,
            ease: EASE,
            stagger: 0.07,
            scrollTrigger: { trigger: grid, start: 'top 80%', once: true },
          });
        });
  
        // ===== المينيو =====
      const menu = document.querySelector<HTMLElement>('#menu');
      const menuBtn = document.querySelector<HTMLButtonElement>('#menuBtn');
      const menuBg = document.querySelector<HTMLVideoElement>('#menuBg');

      if (menu && menuBtn && menuBg) {
        const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'));
        const lines = menu.querySelectorAll<HTMLElement>('.menu-line > span');
        let open = false;

        const setBg = (src: string) => {
          if (!src) { menu.classList.remove('has-bg'); menuBg.removeAttribute('src'); return; }
          if (menuBg.getAttribute('src') === src) return;
          menuBg.src = src;
          menuBg.load();
          menuBg.play().then(() => menu.classList.add('has-bg')).catch(() => {});
        };

        const openMenu = () => {
          if (open) return;
          open = true;
          menu.classList.add('is-open');
          menu.setAttribute('aria-hidden', 'false');
          menuBtn.setAttribute('aria-expanded', 'true');
          document.documentElement.style.overflow = 'hidden';
          if (!reduced) {
            gsap.set(lines, { y: 0, yPercent: 105 });
            gsap.to(lines, { yPercent: 0, duration: 0.7, ease: 'power4.out', stagger: 0.055 });
          }
          links[0]?.focus();
        };

        const closeMenu = () => {
          if (!open) return;
          open = false;
          menu.classList.remove('is-open', 'has-bg');
          menu.setAttribute('aria-hidden', 'true');
          menuBtn.setAttribute('aria-expanded', 'false');
          document.documentElement.style.overflow = '';
          menuBg.pause();
          // دايمًا للزرار، مش لآخر عنصر كان مركّز عليه. الزرار هو اللي
          // بيملك المينيو، والرجوع لحاجة تانية بيسيب المستخدم تايه.
          menuBtn.focus();
        };

        menuBtn.addEventListener('click', () => (open ? closeMenu() : openMenu()), { signal });

        // الهوفر بيشغّل لوب القسم في الخلفية
        links.forEach((a) => {
          a.addEventListener('mouseenter', () => setBg(a.dataset.loop || ''), { signal });
          a.addEventListener('focus', () => setBg(a.dataset.loop || ''), { signal });
        });
        menu.addEventListener('mouseleave', () => setBg(''), { signal });

        addEventListener('keydown', (e) => {
          if (!open) return;
          if (e.key === 'Escape') { e.preventDefault(); closeMenu(); return; }
          if (e.key !== 'Tab') return;
          // مصيدة تركيز بترتيب الصفحة الحقيقي: الزرار متكتوب قبل
          // المينيو فهو الأول. لو عكسناهم، الـTab من آخر لينك بيخرج
          // لعناصر الصفحة اللي ورا المينيو.
          const focusables = [menuBtn, ...links];
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }, { signal });

        // التنقّل بيقفلها — غير كده بتفضل مفتوحة فوق الصفحة الجديدة
        document.addEventListener('astro:before-swap', closeMenu, { once: true });
      }

      // الخطوط بتغيّر ارتفاعات العناصر — لازم ScrollTrigger يعيد الحساب بعد ما تحمّل.
        // الشرط على signal عشان مانعملش refresh بعد ما الصفحة اتبدّلت.
        document.fonts?.ready.then(() => { if (!signal.aborted) ScrollTrigger.refresh(); });
  
      };

      // ===== الانتقال بين الصفحات =====
      // مسح بلون الأكسنت زي transition في المونتاج. بيغطي الشاشة قبل ما
      // الصفحة الجديدة تتجهّز، وبيتسحب بعد ما تتركب — فالزائر مايشوفش
      // لحظة التبديل نفسها.
      const wipe = () => document.querySelector<HTMLElement>('#wipe');

      document.addEventListener('astro:before-preparation', (e: any) => {
        const el = wipe();
        if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        // فتح مشروع ليه انتقاله الخاص: الكارت بيتمدد ويبقى الهيرو.
        // المسح هنا كان هيغطي المورف — والـspec بيقول «من غير قطع».
        if (e.to?.pathname?.startsWith('/work/')) return;
        const original = e.loader;
        // بنلفّ الـloader عشان Astro يستنى المسح يغطي قبل ما يبدّل
        e.loader = async () => {
          // y: 0 مقصودة — الـCSS بيحط translateY(100%) وGSAP بيقراها
          // بالبكسل، فلو حطينا yPercent فوقها بيتجمعوا
          await gsap.fromTo(el,
            { y: 0, yPercent: 100 },
            { yPercent: 0, duration: 0.42, ease: 'power3.in' },
          ).then();
          await original();
        };
      });

      document.addEventListener('astro:after-swap', () => {
        // الصفحة الجديدة في مكانها والمسح لسه مغطّي — نبدأ من فوق
        scrollTo(0, 0);
      });

      document.addEventListener('astro:page-load', () => {
        init();
        const el = wipe();
        if (!el) return;
        gsap.to(el, { yPercent: -100, duration: 0.5, ease: 'power3.out',
                      onComplete: () => gsap.set(el, { y: 0, yPercent: 100 }) });
      });

      document.addEventListener('astro:before-swap', teardown);
    </script>
  </body>
</html>
