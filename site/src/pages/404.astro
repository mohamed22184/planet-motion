---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { sections } from '../data/work';

// صفحة اللينك المكسور بلغة المونتاج: لقطة مش موجودة في التايم لاين.
// وبدل ما تبقى طريق مسدود، بتدّي للزائر أقرب حاجة — الأقسام نفسها.
---

<Base
  title="404 — Planet Motion"
  description="Clip not found — Planet Motion."
>
  <div class="frame" aria-hidden="true">
    <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
  </div>

  <div class="top">
    <a class="mono" href="/">← Planet Motion</a>
    <span class="mono tc">--:--:--:--</span>
  </div>

  <main class="wrap page" id="main" tabindex="-1">
    <span class="mark" aria-hidden="true"><Mark size={46} /></span>

    <h1 data-reveal>
      <span class="line-mask"><span>Clip not</span></span>
      <span class="line-mask"><span><em>found</em></span></span>
    </h1>

    <p class="lede" dir="rtl">
      اللقطة دي مش في التايم لاين. ممكن تكون اتشالت أو اللينك اتكتب غلط.
    </p>

    <nav class="go" data-stagger aria-label="Sections">
      {sections.map((sec) => (
        <a href={sec.id === 'about' || sec.id === 'contact' ? `/${sec.id}` : `/#${sec.id}`}>
          <span class="mono k">{sec.meta}</span>
          <strong>{sec.label}</strong>
        </a>
      ))}
    </nav>
  </main>
</Base>

<style>
  .frame {
    position: fixed; inset: var(--fi); z-index: 40; pointer-events: none;
    border: 1px solid rgba(215, 204, 200, .09);
  }
  .frame .c { position: absolute; width: 9px; height: 9px; }
  .frame .c::before, .frame .c::after { content: ''; position: absolute; background: rgba(215,204,200,.3); }
  .frame .c::before { width: 100%; height: 1px; }
  .frame .c::after { width: 1px; height: 100%; }
  .frame .tl { top: -1px; left: -1px; }
  .frame .tr { top: -1px; right: -1px; } .frame .tr::after { right: 0; }
  .frame .bl { bottom: -1px; left: -1px; } .frame .bl::before { bottom: 0; }
  .frame .br { bottom: -1px; right: -1px; } .frame .br::before { bottom: 0; } .frame .br::after { right: 0; }

  .top {
    position: fixed; z-index: 55; top: var(--fi);
    left: var(--fi); right: var(--fi);
    display: flex; justify-content: space-between; padding-top: 7px;
  }
  .top a { text-decoration: none; color: var(--text-dim); }
  .top a:hover { color: var(--accent); }

  .page { padding-block: calc(var(--fi) + 96px) var(--s-8); }
  .mark { display: block; color: var(--text-mute); margin-bottom: var(--s-5); }

  h1 { font-size: var(--t-h1); }
  h1 em { font-style: normal; color: var(--accent); font-family: var(--font-display); }

  .lede {
    font-family: var(--font-ar); max-width: 46ch;
    margin: var(--s-4) 0 var(--s-7); color: var(--text-dim);
  }

  .go { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--s-3); }
  .go a {
    display: grid; gap: 4px; padding: var(--s-3) 0;
    border-top: 1px solid var(--line); text-decoration: none;
  }
  .go strong { font-family: var(--font-display); font-size: 1.35rem; letter-spacing: -.02em; }
  .go a:hover strong { color: var(--accent); }
</style>
