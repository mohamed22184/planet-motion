---
import Base from '../layouts/Base.astro';

// الريبورت: إيميل + واتساب + رابط حجز مكالمة. من غير فورم طويل —
// الفورم الطويل بيضيّع العميل، والإيميل المباشر بيوصل أسرع.
const ways = [
  { label: 'Email',    value: 'hello@planetmotion.studio', href: 'mailto:hello@planetmotion.studio', note: 'أسرع طريقة — بيتردّ عليه في نفس اليوم' },
  { label: 'WhatsApp', value: '+20 ——— ———',              href: 'https://wa.me/20',                   note: 'للمشاريع المستعجلة' },
  { label: 'Call',     value: 'احجز 20 دقيقة',             href: '#',                                  note: 'لو المشروع محتاج كلام قبل العرض' },
];

const info = [
  ['Based in', 'Cairo · Riyadh'],
  ['Timezone', 'GMT+2 / GMT+3'],
  ['Languages', 'العربية · English'],
  ['Working on', 'Brand films · Social · AI workflows'],
];
---

<Base
  title="Contact — Planet Motion"
  description="Start a project with Planet Motion — Mohamed, video editor and motion designer in Cairo and Riyadh."
>
  <div class="frame" aria-hidden="true">
    <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
  </div>

  <div class="top">
    <a class="mono" href="/">← Planet Motion</a>
    <span class="mono av"><i class="dot"></i> Available</span>
  </div>

  <main class="wrap page" id="main" tabindex="-1">
    <h1 data-reveal>
      <span class="line-mask"><span>Let's</span></span>
      <span class="line-mask"><span><em>talk</em></span></span>
    </h1>

    <ul class="ways" data-stagger>
      {ways.map((w) => (
        <li>
          <a href={w.href}>
            <span class="mono k">{w.label}</span>
            <strong>{w.value}</strong>
            <span class="mono n" dir="rtl">{w.note}</span>
          </a>
        </li>
      ))}
    </ul>

    <dl class="info">
      {info.map(([k, v]) => (
        <div><dt class="mono">{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>
  </main>
</Base>

<style>
  .frame {
    position: fixed; inset: var(--fi); z-index: 40; pointer-events: none;
    border: 1px solid rgba(215, 204, 200, .09);
  }
  .frame .c { position: absolute; width: 9px; height: 9px; }
  .frame .c::before, .frame .c::after { content: ''; position: absolute; background: rgba(215,204,200,.3); }
  .frame .c::before { width: 100%; height: 1px; }
  .frame .c::after { width: 1px; height: 100%; }
  .frame .tl { top: -1px; left: -1px; }
  .frame .tr { top: -1px; right: -1px; } .frame .tr::after { right: 0; }
  .frame .bl { bottom: -1px; left: -1px; } .frame .bl::before { bottom: 0; }
  .frame .br { bottom: -1px; right: -1px; } .frame .br::before { bottom: 0; } .frame .br::after { right: 0; }

  .top {
    position: fixed; z-index: 55; top: var(--fi); left: var(--fi); right: var(--fi);
    display: flex; justify-content: space-between; padding-top: 7px;
  }
  .top a { text-decoration: none; color: var(--text-dim); }
  .top a:hover { color: var(--accent); }
  .av { display: flex; align-items: center; gap: 8px; }
  .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); animation: pulse 2.4s infinite; }
  @keyframes pulse { 0%,100% { opacity: 1 } 50% { opacity: .25 } }

  .page { padding-block: calc(var(--fi) + 64px) var(--s-8); }
  h1 { font-size: var(--t-hero); }
  h1 em { font-style: normal; color: var(--accent); font-family: var(--font-display); }

  .ways { list-style: none; margin: var(--s-7) 0 0; padding: 0; display: grid; }
  .ways li { border-top: 1px solid var(--line); }
  .ways li:last-child { border-bottom: 1px solid var(--line); }
  .ways a {
    display: grid; grid-template-columns: 110px 1fr auto; gap: var(--s-4);
    align-items: baseline; padding: var(--s-4) 0; text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .ways .k { color: var(--text-mute); }
  .ways strong {
    font-family: var(--font-display); font-size: clamp(1.3rem, 3vw, 2.1rem);
    letter-spacing: -.03em; font-weight: 700;
  }
  .ways .n { color: var(--text-mute); text-align: end; }
  .ways a:hover strong { color: var(--accent); }

  .info {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--s-5); margin: var(--s-7) 0 0;
  }
  .info dt { margin-bottom: 5px; }
  .info dd { margin: 0; font-size: .95rem; color: var(--text-dim); }

  @media (max-width: 760px) {
    .ways a { grid-template-columns: 1fr; gap: 4px; }
    .ways .n { text-align: start; }
  }
</style>
