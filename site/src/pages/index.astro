---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';

// بنقرا اللوبات الموجودة فعلًا وقت البناء. الكارت اللي ملوش ملف
// مابياخدش عنصر فيديو أصلًا — من غير كده كل كارت بيعمل طلبين
// فاشلين وبيوسّخ الكونسول.
const loopsDir = path.join(process.cwd(), 'public', 'loops');
const loopFiles = new Set(
  fs.existsSync(loopsDir) ? fs.readdirSync(loopsDir) : [],
);
const hasLoop = (name: string) =>
  loopFiles.has(`${name}.mp4`) || loopFiles.has(`${name}.webm`);

// كل قسم = مجموعة فيديوهات في عنقود ثلاثي الأبعاد.
// x/y/z = مركز العنقود · العناصر متوزعة حواليه بإزاحات صغيرة
// عشان يبقى للعنقود نفسه عمق جوّاه.
const sections = [
  {
    id: 'reel', label: 'Reel 2026', meta: '01:24', d: 470,
    x: 0, y: 0, z: -250,
    items: [{ w: 660, ar: '16 / 9', dx: 0, dy: 0, dz: 0, tc: '00:00' }],
  },
  {
    // كل عنقود فيه كارت مسيطر وباقي الكروت أصغر بوضوح — التباين في
    // المقاس هو اللي بيدي العين نقطة تبدأ منها
    id: 'motion', label: 'Motion', meta: '05 films', d: 180,
    x: -1560, y: -700, z: -1200,
    items: [
      { w: 470, ar: '16 / 9', dx: -150, dy: -120, dz:  200, tc: '00:42' },
      { w: 190, ar: '1 / 1',  dx:  250, dy: -175, dz:  -60, tc: '01:10' },
      { w: 230, ar: '16 / 9', dx:  245, dy:   55, dz:  150, tc: '00:28' },
      { w: 150, ar: '9 / 16', dx:  -95, dy:  190, dz: -110, tc: '00:55' },
      { w: 175, ar: '1 / 1',  dx:  165, dy:  235, dz: -260, tc: '02:06' },
    ],
  },
  {
    id: 'ai', label: 'AI', meta: '04 experiments', d: 190,
    x: 1580, y: -700, z: -1600,
    items: [
      { w: 420, ar: '16 / 9', dx:  110, dy: -110, dz:  180, tc: '00:33' },
      { w: 165, ar: '9 / 16', dx: -215, dy:  -60, dz:  -40, tc: '00:18' },
      { w: 185, ar: '1 / 1',  dx:  185, dy:  165, dz:  120, tc: '00:47' },
      { w: 215, ar: '16 / 9', dx: -170, dy:  195, dz: -200, tc: '01:02' },
    ],
  },
  {
    id: 'edit', label: 'Edit', meta: '04 cuts', d: 185,
    x: -1700, y: 620, z: -1000,
    items: [
      { w: 450, ar: '16 / 9', dx: -130, dy: -115, dz:  190, tc: '01:35' },
      { w: 180, ar: '1 / 1',  dx:  235, dy: -145, dz:  -70, tc: '00:51' },
      { w: 225, ar: '16 / 9', dx:  230, dy:   75, dz:  140, tc: '02:14' },
      { w: 155, ar: '9 / 16', dx:  -85, dy:  195, dz: -190, tc: '00:39' },
    ],
  },
  {
    id: 'about', label: 'About', meta: 'Cairo / Riyadh', d: 300,
    x: 1720, y: 620, z: -2000,
    items: [{ w: 430, ar: '1 / 1', dx: 0, dy: 0, dz: 0, tc: '—' }],
  },
  {
    id: 'contact', label: 'Contact', meta: "Let's talk", d: 300,
    x: 0, y: 1250, z: -2400,
    items: [{ w: 500, ar: '16 / 9', dx: 0, dy: 0, dz: 0, tc: '—' }],
  },
];

// جزيئات عالقة في الفراغ — مرجع بصري للعمق. البارالاكس بتاعها
// بييجي من الـperspective لوحده، من غير أي جافاسكريبت.
const motes = Array.from({ length: 46 }, (_, i) => ({
  x: (((i * 733) % 4000) - 2000),
  y: (((i * 457) % 3200) - 1300),
  z: -(((i * 311) % 3400) + 120),
  s: ((i * 97) % 3) + 1,
}));
// نقطة توقف لكل قسم + لقطة الفتح + اللقطة الواسعة
const SEGS = sections.length + 1;
---

<Base title="Planet Motion">
  <!-- الفريم: هايرلاين على حدود الشاشة بعلامات قص في الأركان، زي
       علامات الـsafe area. الواجهة كلها بتقعد عليه بدل ما تبقى
       عناصر طايرة في الأركان. -->
  <div class="frame" aria-hidden="true">
    <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
  </div>

  <!-- السكرابر هو حافة الفريم العليا نفسها -->
  <nav class="scrub" id="scrub" aria-label="Timeline">
    <div class="scrub-track" id="scrubTrack">
      <span class="scrub-prog" id="scrubProg"></span>
      {sections.map((sec, i) => (
        <button
          class="scrub-tick"
          type="button"
          data-go={i + 2}
          data-meta={sec.meta}
          style={`left:${((i + 2) / SEGS) * 100}%`}
          aria-label={sec.label}
        ><i></i></button>
      ))}
      <span class="scrub-head" id="scrubHead"></span>
    </div>
    <div class="scrub-label" id="scrubLabel">
      <span class="n mono" id="scrubN">01</span>
      <span class="t" id="scrubT">Reel 2026</span>
      <span class="m mono" id="scrubM">01:24</span>
    </div>
  </nav>

  <!-- الهوية والتنقّل كلهم على الحافة السفلى — منطقتين بدل أربع أركان -->
  <div class="foot">
    <span class="foot-l mono"><i class="dot"></i> Planet Motion<em> · Available</em></span>
    <span class="foot-r mono"><span id="tc">00:00:00:00</span> <a href="/about">About</a></span>
  </div>

  <section class="stage">
    <div class="scene">
      <div class="world" id="world">
        {motes.map((m) => (
          <i class="mote" data-x={m.x} data-y={m.y} data-z={m.z} style={`width:${m.s}px;height:${m.s}px`}></i>
        ))}

        {sections.map((sec, si) =>
          sec.items.map((it, ii) => (
            <article
              class="card"
              data-sec={si}
              data-x={sec.x + it.dx} data-y={sec.y + it.dy} data-z={sec.z + it.dz}
              data-w={it.w}
            >
              <div class="thumb" style={`aspect-ratio:${it.ar}`}>
                {/* preload="none" مقصودة: مفيش بايت واحد بينزل لحد ما القسم
                    يقرب. الـmp4 الأول والـwebm احتياطي — المتصفح بينتقل
                    للمصدر اللي بعده لوحده لو الأول مالقاهوش. */}
                {hasLoop(`${sec.id}-${ii + 1}`) && (
                  <video
                    class="v"
                    muted loop playsinline preload="none"
                    data-mp4={loopFiles.has(`${sec.id}-${ii + 1}.mp4`) ? `/loops/${sec.id}-${ii + 1}.mp4` : ''}
                    data-webm={loopFiles.has(`${sec.id}-${ii + 1}.webm`) ? `/loops/${sec.id}-${ii + 1}.webm` : ''}
                  ></video>
                )}
                <span class="ar mono">{it.ar.replace(/ /g, '')}</span>
                <span class="dur mono">{it.tc}</span>
              </div>
            </article>
          )),
        )}
      </div>
      <div class="vignette"></div>
    </div>

    <!-- ===== شريط اللقطات ===== -->

  </section>

  <section class="after wrap">
    <h2 data-reveal><span class="line-mask"><span>Selected work</span></span></h2>
    <p class="lede" dir="rtl">الصفحة بتكمّل طبيعي بعد ما الكاميرا تخلص رحلتها.</p>
  </section>
</Base>

<style>
  /* ===== فريم الكاميرا =====
     هايرلاين على حدود الشاشة بعلامات قص في الأركان. كل الواجهة
     بتقعد عليه، فبتقرا كنظام واحد مش عناصر متفرقة. */
  .frame {
    position: fixed; inset: var(--fi); z-index: 40; pointer-events: none;
    border: 1px solid rgba(215, 204, 200, .09);
  }
  .frame .c { position: absolute; width: 9px; height: 9px; }
  .frame .c::before, .frame .c::after {
    content: ''; position: absolute; background: rgba(215, 204, 200, .3);
  }
  .frame .c::before { width: 100%; height: 1px; }
  .frame .c::after { width: 1px; height: 100%; }
  .frame .tl { top: -1px; left: -1px; }
  .frame .tr { top: -1px; right: -1px; }
  .frame .tr::after { right: 0; }
  .frame .bl { bottom: -1px; left: -1px; }
  .frame .bl::before { bottom: 0; }
  .frame .br { bottom: -1px; right: -1px; }
  .frame .br::before { bottom: 0; }
  .frame .br::after { right: 0; }

  /* ===== السكرابر = حافة الفريم العليا ===== */
  .scrub {
    position: fixed; z-index: 55;
    left: var(--fi); right: var(--fi); top: var(--fi);
  }
  .scrub-track { position: relative; height: 20px; cursor: ew-resize; touch-action: none; }
  .scrub-track::before {
    content: ''; position: absolute; left: 0; right: 0; top: 0;
    height: 1px; background: rgba(215, 204, 200, .14);
  }
  .scrub-prog {
    position: absolute; left: 0; top: 0; height: 1px; width: 0;
    background: rgba(215, 204, 200, .32);
  }
  .scrub-tick {
    position: absolute; top: 0; height: 100%; width: 24px;
    transform: translateX(-50%);
    border: 0; background: transparent; padding: 0; cursor: pointer;
    display: flex; justify-content: center; align-items: flex-start;
  }
  .scrub-tick i {
    display: block; width: 1px; height: 6px; background: var(--text-mute);
    transition: height var(--dur-fast) var(--ease-out),
                background var(--dur-fast) var(--ease-out);
  }
  .scrub-tick:hover i { height: 12px; background: var(--text); }
  .scrub-tick[aria-current='true'] i { height: 12px; background: var(--text-dim); }

  /* رأس التشغيل — ده المكان الوحيد تقريبًا اللي الأكسنت بيظهر فيه */
  .scrub-head {
    position: absolute; top: 0; left: 0; height: 14px; width: 1px;
    background: var(--accent); pointer-events: none;
  }
  .scrub-head::before {
    content: ''; position: absolute; top: -1px; left: 50%;
    transform: translateX(-50%);
    border-left: 4px solid transparent; border-right: 4px solid transparent;
    border-top: 5px solid var(--accent);
  }

  .scrub-label {
    position: absolute; top: 20px; left: 0;
    display: flex; align-items: baseline; gap: 8px;
    white-space: nowrap; transform: translateX(-50%);
    transition: opacity .3s var(--ease-out);
  }
  .scrub-label .n { font-size: 9px; color: var(--accent); }
  .scrub-label .t { font-family: var(--font-display); font-size: .95rem; letter-spacing: -.02em; }
  .scrub-label .m { font-size: 9px; color: var(--text-mute); }

  /* ===== الحافة السفلى: الهوية والتنقّل ===== */
  .foot {
    position: fixed; z-index: 55; bottom: var(--fi);
    left: var(--fi); right: var(--fi);
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: 7px; pointer-events: none;
  }
  .foot span { display: flex; align-items: center; gap: 10px; }
  .foot em { font-style: normal; }
  .foot a { pointer-events: auto; text-decoration: none; color: var(--text-dim); }
  .foot a:hover { color: var(--accent); }
  .dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent); animation: pulse 2.4s infinite;
  }
  @keyframes pulse { 0%,100% { opacity: 1 } 50% { opacity: .25 } }

  .stage { height: 760vh; position: relative; }
  .scene {
    position: sticky; top: 0; height: 100vh;
    /* الـperspective بتتظبط من الجافاسكريبت عشان تتقاس مع باقي الأبعاد */
    perspective-origin: 50% 50%;
    overflow: hidden;
  }
  .world { position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform-style: preserve-3d; }

  /* فينيت — بيقفل حواف الفريم فالعين تروح للنص وتحس بعمق أكتر */
  .vignette {
    position: absolute; inset: 0; pointer-events: none; z-index: 5;
    background: radial-gradient(ellipse 70% 62% at 50% 50%, transparent 40%, rgba(10,7,6,.72) 100%);
  }

  .mote {
    position: absolute; left: 0; top: 0; display: block;
    border-radius: 50%; background: var(--text-dim); opacity: .16;
  }

  .card { position: absolute; left: 0; top: 0; will-change: transform, filter, opacity; }
  .thumb {
    position: relative; background: var(--surface-1);
    border: 1px solid var(--line);
  }
  .thumb::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(135deg, rgba(245,245,245,.06), transparent 46%);
  }
  .v {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; display: block;
    opacity: 0; transition: opacity .5s var(--ease-out);
  }
  /* الفيديو مابيبانش غير لما يبقى جاهز فعلًا — من غير كده بيلمع أسود */
  .card.has-video .v { opacity: 1; }
  /* الأكسنت اتشال من براويز الكروت: خمس كروت ببرواز برتقاني مع بعض
     بتخلي الأكسنت أكتر حاجة في الشاشة، والقاعدة إنه تحت 3%.
     القسم المركّز عليه بيبان بوضوح البرواز مش بلونه. */
  .card.is-focus .thumb { border-color: rgba(215, 204, 200, .34); }
  .card:hover .thumb { border-color: var(--accent); }
  .ar  { position: absolute; left: 8px;  bottom: 7px; font-size: 11px; }
  .dur { position: absolute; right: 8px; bottom: 7px; font-size: 11px; }

  .after { padding-block: var(--s-8); border-top: 1px solid var(--line); }
  .after h2 { font-size: var(--t-h1); }
  .lede { color: var(--text-dim); max-width: 60ch; text-align: start; margin-top: var(--s-4); }

  @media (max-width: 760px) {
    .scrub-label .t { font-size: .8rem; }
    .scrub-label .m { display: none; }
    /* النقطة البرتقاني لوحدها بتقول Available — النص بيلفّ على سطرين */
    .foot { font-size: 9px; }
    .foot em { display: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // مع راوتر Astro سكربت الموديول بيتنفّذ مرة واحدة، فالتهيئة بتتنادى
  // على astro:page-load. والمستمعين كلهم مربوطين بـsignal عشان يتفكّوا
  // مع التنقّل بدل ما يتراكموا.
  const run = () => {
    const ac = new AbortController();
    const signal = ac.signal;
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const world = document.querySelector<HTMLElement>('#world')!;
    const cards = gsap.utils.toArray<HTMLElement>('.card');
    const motes = gsap.utils.toArray<HTMLElement>('.mote');
    const track = document.querySelector<HTMLElement>('#scrubTrack')!;
    const prog = document.querySelector<HTMLElement>('#scrubProg')!;
    const head = document.querySelector<HTMLElement>('#scrubHead')!;
    const label = document.querySelector<HTMLElement>('#scrubLabel')!;
    const ticks = gsap.utils.toArray<HTMLButtonElement>('.scrub-tick');
  
    // التقريب = perspective / (perspective - d). عشان نفس التكوين يظهر
    // على أي مقاس، لازم كل الأطوال تتقاس بنفس النسبة — المواقع والعروض
    // والمسافات **والـperspective نفسها**. لو الـperspective فضلت ثابتة
    // المشهد بيصغر على الشاشة الصغيرة بدل ما يتقاس.
    const scene = document.querySelector<HTMLElement>('.scene')!;
  
    type Card = {
      el: HTMLElement; sec: number;
      bx: number; by: number; bz: number; bw: number;   // القيم الأساسية
      x: number; y: number; z: number;                  // بعد القياس
    };
    const items: Card[] = cards.map((el) => ({
      el, sec: Number(el.dataset.sec),
      bx: Number(el.dataset.x), by: Number(el.dataset.y),
      bz: Number(el.dataset.z), bw: Number(el.dataset.w),
      x: 0, y: 0, z: 0,
    }));
  
    let fit = 1;
  
    // العنقود محتاج الكاميرا ترجع لورا عشان يدخل الفريم كله؛
    // الكارت الواحد محتاجها تقرّب.
    const SEC_D_BASE = [470, -130, -110, -120, 300, 300];
    type WP = { tx: number; ty: number; tz: number; d: number; rx: number; ry: number };
    let waypoints: WP[] = [];
  
    // اللقطة الواسعة متحسوبة من امتداد الكروت الفعلي، مش أرقام ثابتة —
    // كده أي تعديل في المواقع بيتظبط لوحده.
    const computeWide = (): WP => {
      const halfW = items.map((c) => Math.abs(c.x) + (Number(c.el.dataset.w) * fit) / 2);
      const halfH = items.map((c) => Math.abs(c.y) + (Number(c.el.dataset.w) * fit) / 2);
      // الهدف هو الريل نفسه (مركز الفراغ) مش مركز صندوق الإحاطة.
      // لو اتمركزنا على صندوق الإحاطة، الريل بيزيح عن النص لأن
      // الأقسام مش متوزعة بالتساوي حواليه تمامًا. وحساب halfW/halfH
      // تحت متبني على المسافة من الأصل أصلًا، فده بيخلّيهم متسقين.
      const zs = items.map((c) => c.z);
      const tx = 0, ty = 0;
      const tz = (Math.min(...zs) + Math.max(...zs)) / 2;
  
      const P = 900 * fit;
      // التقريب المطلوب عشان الامتداد كله يدخل الفريم مع هامش
      const need = Math.min(
        (innerWidth / 2) * 0.92 / Math.max(...halfW),
        (innerHeight / 2) * 0.84 / Math.max(...halfH),
      );
      // الكروت الأقرب بتتكبر أكتر من المركز، فبناخد هامش أمان
      // 0.82 مش 1: الكروت الأقرب بتتكبر أكتر من المركز، وبارالاكس
      // الماوس بيلفّ المشهد — الهامش بيحسب للاتنين
      const d = P * (1 - 1 / (need * 0.82));
      return { tx, ty, tz, d, rx: 0, ry: 0 };
    };
  
    // كل الأطوال بتتقاس بنفس النسبة — المواقع والعروض والمسافات
    // والـperspective. لازم تتنادى تاني مع أي تغيير في مقاس النافذة،
    // وإلا التكوين بيبوظ.
    const layout = () => {
      fit = Math.min(1, innerWidth / 1440);
      scene.style.perspective = `${900 * fit}px`;
  
      items.forEach((c) => {
        c.x = c.bx * fit; c.y = c.by * fit; c.z = c.bz * fit;
        c.el.style.width = `${c.bw * fit}px`;
        gsap.set(c.el, { xPercent: -50, yPercent: -50, x: c.x, y: c.y, z: c.z });
      });
      motes.forEach((m) => {
        gsap.set(m, {
          xPercent: -50, yPercent: -50,
          x: Number(m.dataset.x) * fit, y: Number(m.dataset.y) * fit, z: Number(m.dataset.z) * fit,
        });
      });
  
      const secs = [...new Set(items.map((i) => i.sec))].map((si) => {
        const g = items.filter((i) => i.sec === si);
        return {
          x: g.reduce((a, b) => a + b.x, 0) / g.length,
          y: g.reduce((a, b) => a + b.y, 0) / g.length,
          z: g.reduce((a, b) => a + b.z, 0) / g.length,
        };
      });
  
      waypoints = [
        // 0 = قريب على الـReel · 1 = لقطة واسعة بتكشف الفراغ كله · 2.. = كل قسم
        { tx: secs[0].x, ty: secs[0].y, tz: secs[0].z, d: SEC_D_BASE[0] * fit, rx: 0, ry: 0 },
        computeWide(),
        ...secs.map((s, i) => ({ tx: s.x, ty: s.y, tz: s.z, d: SEC_D_BASE[i] * fit, rx: 0, ry: 0 })),
      ];
  
      // الكاميرا بتميل في اتجاه حركتها
      for (let i = 1; i < waypoints.length; i++) {
        const dx = waypoints[i].tx - waypoints[i - 1].tx;
        const dy = waypoints[i].ty - waypoints[i - 1].ty;
        waypoints[i].ry = gsap.utils.clamp(-18, 18, -dx / 95);
        waypoints[i].rx = gsap.utils.clamp(-11, 11, dy / 120);
      }
    };
  
    layout();
  
    const cam: WP = { ...waypoints[0] };
    const rad = (d: number) => (d * Math.PI) / 180;
  
    let lastSec = -2;
  
    // ===== نظرة الكاميرا =====
    // الكاميرا بتلفّ ناحية الماوس بتخميد، ومعاها انجراف بطيء مستمر.
    // الدوران بيحصل حوالين الهدف، فالعناصر القريبة بتزيح أكتر من
    // البعيدة لوحدها — ده البارالاكس بييجي من المنظور مش من كود.
    const look = { x: 0, y: 0 };
    const lookT = { x: 0, y: 0 };
    // الزاوية لازم تتقاس بمسافة الكاميرا. زاوية ثابتة بتبقى خفيفة
    // في اللقطة الواسعة (الكاميرا بعيدة فالإزاحة على الشاشة صغيرة)،
    // وبتفجّر المشهد عند التركيز على قسم: الدوران بيقرّب الكروت من
    // مستوى المنظور فالتكبير بيطلع لأرقام خيالية وتطير برّه الفريم.
    const LOOK_RY = 6, LOOK_RX = 4.2;
    const lookAmp = () => {
      const P = 900 * fit;
      const sc = P / (P - cam.d);                 // تكبير الهدف الحالي
      return gsap.utils.clamp(0.4, 1.8, 1 / sc);  // قريب = أقل، بعيد = أكتر
    };

    const applyCamera = () => {
      // الانجراف البطيء بيمنع المشهد إنه يتجمّد تمامًا لما الزائر يقف
      const t = performance.now();
      const dy = Math.sin(t * 0.00011) * 1.1;
      const dx = Math.cos(t * 0.00009) * 0.8;

      const amp = lookAmp();
      const ry = cam.ry + look.x * LOOK_RY * amp + dy;
      const rx = cam.rx - look.y * LOOK_RX * amp + dx;

      world.style.transform =
        `translateZ(${cam.d}px) rotateX(${rx}deg) rotateY(${ry}deg) ` +
        `translate3d(${-cam.tx}px, ${-cam.ty}px, ${-cam.tz}px)`;

      const sy = Math.sin(rad(ry)), cy = Math.cos(rad(ry));
      const sx = Math.sin(rad(rx)), cx = Math.cos(rad(rx));
  
      items.forEach((c) => {
        const px = c.x - cam.tx, py = c.y - cam.ty, pz = c.z - cam.tz;
        const z1 = -px * sy + pz * cy;
        const eff = py * sx + z1 * cx + cam.d;
        const dist = Math.abs(eff - cam.d);
  
        // تمويه (عمق ميدان) + خفوت (عمق جوي). الاتنين مع بعض هما اللي
        // بيخلّوا المخ يقرا المسافة — التمويه لوحده مابيكفيش.
        // الكارت اللي الفيديو بتاعه شغّال بيفضل حاد دايمًا.
        // تمويه فيديو شغّال معناه إعادة ترسيم مع كل فريم — ده أغلى
        // بكتير من تمويه صورة ثابتة (اللي بتترسم مرة واحدة).
        const playing = c.sec === lastSec;
        const b = playing ? 0 : Math.round(Math.min(dist / (520 * fit), 7) * 2) / 2;
        const o = Math.round(Math.max(1 - dist / (3400 * fit), 0.12) * 20) / 20;
  
        if (c.el.dataset.b !== String(b)) {
          c.el.style.filter = b ? `blur(${b}px)` : 'none';
          c.el.dataset.b = String(b);
        }
        if (c.el.dataset.o !== String(o)) {
          c.el.style.opacity = String(o);
          c.el.dataset.o = String(o);
        }
      });
    };
  
    const nEl = document.querySelector<HTMLElement>('#scrubN')!;
    const tEl = document.querySelector<HTMLElement>('#scrubT')!;
    const mEl = document.querySelector<HTMLElement>('#scrubM')!;
    const labels = ticks.map((b) => ({
      name: b.getAttribute('aria-label') || '',
      meta: b.dataset.meta || '',
    }));
  
    // ===== طبقة الفيديو =====
    // القاعدة: الفيديو بيشتغل للقسم المركّز عليه بس. الأقسام المجاورة
    // بتحمّل استعدادًا، والباقي متوقف. كده الحمل ثابت مهما زاد عدد
    // المشاريع — 30 مشروع بيكلّفوا نفس الـ5.
    const loaded = new WeakSet<HTMLVideoElement>();
  
    const ensureLoaded = (v: HTMLVideoElement) => {
      if (loaded.has(v)) return;
      loaded.add(v);
      for (const [src, type] of [
        [v.dataset.mp4, 'video/mp4'],
        [v.dataset.webm, 'video/webm'],
      ] as const) {
        if (!src) continue;
        const el = document.createElement('source');
        el.src = src; el.type = type;
        v.append(el);
      }
      // لو مفيش ملف، الكارت بيفضل مستطيل فاضي — مفيش رسالة خطأ للزائر
      v.addEventListener('loadeddata', () => v.closest('.card')!.classList.add('has-video'));
      v.preload = 'auto';
      v.load();
    };
  
    // القياس بيقول إن الفيديو هو أغلى حاجة في الصفحة، مش العمق:
    // من غير فيديو p95 = 9.3ms وصفر فريم متأخر؛ وبفيديو شغّال أثناء
    // حركة الكاميرا p95 = 31.8ms و5% فريمات متأخرة.
    // عشان كده الفيديو بيقف أثناء الحركة وبيشتغل لما الكاميرا تستقر —
    // وقت الحركة هو اللي محتاجين فيه كل الميزانية، والكارت الثابت
    // يقدر يستنى ثانية.
    let settled = false;
  
    const setPlayback = () => {
      if (reduced) return;
      items.forEach((c) => {
        const v = c.el.querySelector<HTMLVideoElement>('.v');
        if (!v) return;
        if (Math.abs(c.sec - lastSec) <= 1) ensureLoaded(v);
        if (settled && c.sec === lastSec) {
          // الوعد بيترفض لو المتصفح منع التشغيل — مش مشكلة، الكارت
          // بيفضل ثابت. مفيش داعي نزعج الزائر بيه.
          v.play().catch(() => {});
        } else if (!v.paused) {
          v.pause();
        }
      });
    };
  
    let settleT: number;
    const markMoving = () => {
      if (settled) { settled = false; setPlayback(); }
      clearTimeout(settleT);
      settleT = window.setTimeout(() => { settled = true; setPlayback(); }, 220);
    };
  
    const setCurrent = (i: number) => {
      const s = i - 2;
      if (s === lastSec) return;
      lastSec = s;
      setPlayback();
      ticks.forEach((b, bi) => b.setAttribute('aria-current', String(bi === s)));
      items.forEach((c) => c.el.classList.toggle('is-focus', c.sec === s));
      if (s === -1) {
        nEl.textContent = '--';
        tEl.textContent = 'All work';
        mEl.textContent = `${labels.length} sections`;
      } else {
        const l = labels[s];
        if (l) {
          nEl.textContent = String(s + 1).padStart(2, '0');
          tEl.textContent = l.name;
          mEl.textContent = l.meta;
        }
      }
    };
  
    applyCamera();
  
    const segs = waypoints.length - 1;
    const EASE = gsap.parseEase('power3.inOut');
  
    // الكاميرا بقت دالة في التقدّم بدل تايم لاين من تويناتproximity متتابعة.
    // ده اللي بيخلّي القفزة المباشرة ممكنة: السكرول بيحرّك p، والقفزة
    // بتحرّك الكاميرا نفسها من غير ما تعدّي على النقط اللي في النص.
    const applyProgress = (p: number) => {
      const t = gsap.utils.clamp(0, segs, p * segs);
      const i = Math.min(Math.floor(t), segs - 1);
      const f = EASE(t - i);
      const a = waypoints[i], b = waypoints[i + 1];
      cam.tx = a.tx + (b.tx - a.tx) * f;
      cam.ty = a.ty + (b.ty - a.ty) * f;
      cam.tz = a.tz + (b.tz - a.tz) * f;
      cam.d  = a.d  + (b.d  - a.d)  * f;
      cam.rx = a.rx + (b.rx - a.rx) * f;
      cam.ry = a.ry + (b.ry - a.ry) * f;
      applyCamera();
      markMoving();
    };
  
    // رأس التشغيل والخط والاسم — كلهم بيتحركوا مع نفس القيمة
    const paintHead = (p: number) => {
      const pc = gsap.utils.clamp(0, 1, p) * 100;
      head.style.left = `${pc}%`;
      prog.style.width = `${pc}%`;
      // الاسم بيتثبّت بعرضه الفعلي مش بنسبة ثابتة — النسبة الثابتة
      // بتقطعه على الشاشة الضيقة لأن عرضه بيبقى جزء كبير من المسار
      const tw = track.offsetWidth;
      const half = label.offsetWidth / 2;
      const px = gsap.utils.clamp(half, Math.max(half, tw - half), (pc / 100) * tw);
      label.style.left = `${(px / tw) * 100}%`;
    };

    applyProgress(0);
    paintHead(0);

    // اللمس مستثنى: pointermove على الموبايل بيحصل وإنت ساحب للسكرول،
    // فالمشهد كان هيلفّ مع كل سحبة ويزاحم إحساس السكرول نفسه.
    if (!reduced && matchMedia('(pointer: fine)').matches) {
      addEventListener('pointermove', (e) => {
        lookT.x = (e.clientX / innerWidth - 0.5) * 2;
        lookT.y = (e.clientY / innerHeight - 0.5) * 2;
      }, { passive: true, signal });

      // التخميد هو اللي بيدي الإحساس بالسلاسة: المشهد بيلحق الماوس
      // بتأخير بدل ما يلزق فيه. 0.055 ≈ نص ثانية عشان يستقر.
      const tick = () => {
        // تخميد أبطأ = وزن أكتر. المشهد بياخد وقته وهو بيلحق الماوس،
        // وده اللي بيدي الإحساس بالثقل بدل ما يبقى لازق في الكيرسر.
        look.x += (lookT.x - look.x) * 0.042;
        look.y += (lookT.y - look.y) * 0.042;
        applyCamera();
      };
      gsap.ticker.add(tick);
      signal.addEventListener('abort', () => gsap.ticker.remove(tick));
    }
  
    if (reduced) {
      Object.assign(cam, waypoints[1]);
      applyCamera();
    } else {
      let jumping = false;
      const pos = { p: 0 };
  
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '.stage', start: 'top top', end: 'bottom bottom', scrub: 1.1,
          onUpdate: (self) => {
            setCurrent(Math.round(self.progress * segs));
            paintHead(self.progress);
          },
        },
      });
      tl.to(pos, {
        p: 1, duration: 1, ease: 'none',
        onUpdate: () => { if (!jumping) applyProgress(pos.p); },
      });
  
    
      // المسار نفسه بيفضل ظاهر — هو رفيع كفاية. الاسم بس هو اللي
      // بيخفت مع السكون، فالواجهة تسيب الشغل يتكلم من غير ما تختفي.
      let hideT: number;
      const wake = () => {
        label.style.opacity = '1';
        clearTimeout(hideT);
        hideT = window.setTimeout(() => { label.style.opacity = '.35'; }, 2600);
      };
      ['mousemove', 'wheel', 'touchstart', 'keydown'].forEach((e) =>
        addEventListener(e, wake, { passive: true, signal }),
      );
      track.addEventListener('mouseenter', () => clearTimeout(hideT), { signal });
      track.addEventListener('mouseleave', wake, { signal });
      wake();
  
      // ===== التنقّل =====
      let idx = 0;
  
      // السكرول بيمشي على النقط بالترتيب (ده المقصود منه).
      // لكن الكليك والأسهم بيروحوا على طول: بنحرّك السكرول فورًا من غير
      // scrub عشان مايتفرجش على الطريق، وبنطيّر الكاميرا من مكانها للهدف.
      const jumpTo = (i: number) => {
        const next = gsap.utils.clamp(0, segs, i);
        if (next === idx && !jumping) return;
        idx = next;
  
        // الحدود بتتاخد من ScrollTrigger نفسه مش من offsetTop/offsetHeight:
        // بعد التحميل الأبعاد بتتغير مع تحميل الخطوط، وScrollTrigger بيعيد
        // حساب start/end عند الـrefresh فبيفضلوا مظبوطين.
        const sc = tl.scrollTrigger!;
        const y = sc.start + (sc.end - sc.start) * (idx / segs);
        jumping = true;
  
        const lenis = (window as any).__lenis;
        if (lenis) lenis.scrollTo(y, { immediate: true });
        else scrollTo({ top: y, behavior: 'auto' });
  
        // التايم لاين يتظبط على الهدف فورًا، فأي سكرول بعد كده يكمّل من هناك
        pos.p = idx / segs;
        tl.progress(idx / segs);
        setCurrent(idx);
        paintHead(idx / segs);
  
        gsap.killTweensOf(cam);
        gsap.to(cam, {
          tx: waypoints[idx].tx, ty: waypoints[idx].ty, tz: waypoints[idx].tz,
          d: waypoints[idx].d, rx: waypoints[idx].rx, ry: waypoints[idx].ry,
          duration: 1.5, ease: 'power3.inOut',
          onUpdate: () => { applyCamera(); markMoving(); },
          onComplete: () => { jumping = false; },
        });
      };
  
      ticks.forEach((b) =>
        b.addEventListener('click', (e) => { e.stopPropagation(); jumpTo(Number(b.dataset.go)); }),
      );

      // ===== السحب على المسار =====
      // السحب بيحرّك السكرول مباشرة — يعني بيتصرف زي السكرول بالظبط،
      // بيعدّي على اللقطات اللي في الطريق. ده المقصود من الـscrub.
      let scrubbing = false;
      const fracFrom = (clientX: number) => {
        const r = track.getBoundingClientRect();
        return gsap.utils.clamp(0, 1, (clientX - r.left) / r.width);
      };
      const scrubTo = (clientX: number) => {
        const sc = tl.scrollTrigger!;
        const y = sc.start + (sc.end - sc.start) * fracFrom(clientX);
        const lenis = (window as any).__lenis;
        if (lenis) lenis.scrollTo(y, { immediate: true });
        else scrollTo({ top: y, behavior: 'auto' });
      };

      track.addEventListener('pointerdown', (e) => {
        // الكليك على علامة بيتولّى القفز المباشر بنفسه
        if ((e.target as HTMLElement).closest('.scrub-tick')) return;
        scrubbing = true;
        jumping = false;
        gsap.killTweensOf(cam);
        track.setPointerCapture(e.pointerId);
        scrubTo(e.clientX);
      }, { signal });

      track.addEventListener('pointermove', (e) => {
        if (scrubbing) scrubTo(e.clientX);
      }, { signal });

      const endScrub = (e: PointerEvent) => {
        if (!scrubbing) return;
        scrubbing = false;
        try { track.releasePointerCapture(e.pointerId); } catch {}
      };
      track.addEventListener('pointerup', endScrub, { signal });
      track.addEventListener('pointercancel', endScrub, { signal });
      items.forEach((c) => c.el.addEventListener('click', () => jumpTo(c.sec + 2)));
      addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        jumpTo(idx + (e.key === 'ArrowRight' ? 1 : -1));
      }, { signal });
  
      // لو المستخدم عمل سكرول بنفسه، بنلغي القفزة ونرجّع السكرول هو المتحكم
      addEventListener('wheel', () => {
        if (!jumping) return;
        jumping = false;
        gsap.killTweensOf(cam);
      }, { passive: true, signal });
  
      ScrollTrigger.create({
        trigger: '.stage', start: 'top top', end: 'bottom bottom',
        onUpdate: (self) => { if (!jumping) idx = Math.round(self.progress * segs); },
      });
  
      // تغيير مقاس النافذة بيغيّر كل الأطوال وطول المسرح، فنفس موضع السكرول
      // بيبقى يساوي لقطة تانية. بنعيد الحساب وبنرجّع المستخدم لنفس اللقطة.
      let rT: number;
      addEventListener('resize', () => {
        clearTimeout(rT);
        rT = window.setTimeout(() => {
          const keep = idx;
          layout();
          ScrollTrigger.refresh();
          const sc = tl.scrollTrigger!;
          const y = sc.start + (sc.end - sc.start) * (keep / segs);
          const lenis = (window as any).__lenis;
          if (lenis) lenis.scrollTo(y, { immediate: true });
          else scrollTo({ top: y, behavior: 'auto' });
          prog.p = keep / segs;
          tl.progress(keep / segs);
          idx = keep;
          Object.assign(cam, waypoints[keep]);
          applyCamera();
        }, 180);
      }, { signal });
    }
  
    const tc = document.querySelector<HTMLElement>('#tc')!;
    const pad = (n: number) => String(Math.floor(n)).padStart(2, '0');
    ScrollTrigger.create({
      trigger: document.body, start: 'top top', end: 'bottom bottom',
      onUpdate: (self) => {
        const t = self.progress * 84;
        tc.textContent = `00:${pad(t / 60)}:${pad(t % 60)}:${pad((t * 25) % 25)}`;
      },
    });
  
  };

  document.addEventListener('astro:page-load', () => {
    // page-load بيقع على كل الصفحات — نشتغل بس لو المسرح موجود
    if (document.querySelector('.stage')) run();
  });
</script>
