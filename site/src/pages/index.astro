---
import Base from '../layouts/Base.astro';

// مواقع الكروت في فراغ ثلاثي الأبعاد، بالبكسل، والمركز (0,0,0).
// الكاميرا بتتنقل بينهم زي ما بتتنقل بين لقطات على تايم لاين.
const shots = [
  { id: 'reel',    label: 'Reel 2026', meta: '01:24',          x:    0, y:    0, z:  -250, w: 640, ar: '16 / 9' },
  { id: 'motion',  label: 'Motion',    meta: '18 projects',    x: -900, y: -460, z: -1000, w: 380, ar: '1 / 1'  },
  { id: 'ai',      label: 'AI',        meta: '06 projects',    x:  950, y: -380, z: -1500, w: 300, ar: '9 / 16' },
  { id: 'edit',    label: 'Edit',      meta: '11 projects',    x: -820, y:  520, z:  -760, w: 440, ar: '16 / 9' },
  { id: 'about',   label: 'About',     meta: 'Cairo / Riyadh', x: 1020, y:  480, z: -1850, w: 360, ar: '1 / 1'  },
  { id: 'contact', label: 'Contact',   meta: "Let's talk",     x: -160, y:  900, z: -2300, w: 420, ar: '16 / 9' },
];
---

<Base title="Camera — Planet Motion">
  <div class="furniture">
    <span class="mono tl">Planet<br />Motion</span>
    <span class="mono tr">Menu</span>
    <span class="mono bl"><i class="dot"></i> Available</span>
    <span class="mono br" id="tc">00:00:00:00</span>
  </div>

  <!-- شريط اللقطات — زي ماركرات التايم لاين -->
  <nav class="shotbar" id="shotbar">
    {shots.map((s, i) => (
      <button class="shot-btn" data-go={i + 1} type="button">
        <span class="mono">{String(i + 1).padStart(2, '0')}</span>
        <span class="shot-name">{s.label}</span>
      </button>
    ))}
  </nav>

  <section class="stage">
    <div class="scene">
      <div class="world" id="world">
        {shots.map((s, i) => (
          <article
            class="card"
            id={`s-${s.id}`}
            data-i={i}
            data-x={s.x} data-y={s.y} data-z={s.z} data-w={s.w}
          >
            <div class="thumb" style={`aspect-ratio:${s.ar}`}>
              <span class="ar mono">{s.ar.replace(/ /g, '')}</span>
            </div>
            <div class="meta">
              <strong>{s.label}</strong>
              <span class="mono">{s.meta}</span>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="hud mono" id="hud">Scroll · click a shot · ← →</div>
  </section>

  <section class="after wrap">
    <h2 data-reveal><span class="line-mask"><span>Selected work</span></span></h2>
    <p class="lede" dir="rtl">الصفحة بتكمّل طبيعي بعد ما الكاميرا تخلص رحلتها.</p>
  </section>
</Base>

<style>
  .furniture { position: fixed; inset: 0; z-index: 60; pointer-events: none; }
  .furniture span { position: absolute; }
  .tl { top: var(--s-4); left: var(--s-4); line-height: 1.3; color: var(--text); }
  .tr { top: var(--s-4); right: var(--s-4); }
  .bl { bottom: var(--s-4); left: var(--s-4); display: flex; align-items: center; gap: var(--s-2); }
  .br { bottom: var(--s-4); right: var(--s-4); }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: pulse 2.4s infinite; }
  @keyframes pulse { 0%,100% { opacity: 1 } 50% { opacity: .25 } }

  /* ===== شريط اللقطات ===== */
  .shotbar {
    position: fixed; z-index: 55; left: 50%; bottom: var(--s-5);
    transform: translateX(-50%);
    display: flex; gap: 1px; background: var(--line);
    border: 1px solid var(--line);
  }
  .shot-btn {
    display: flex; align-items: center; gap: 7px;
    padding: 7px 13px; border: 0; background: var(--ink);
    color: var(--text-mute); font: inherit; cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .shot-btn .mono { font-size: 9px; }
  .shot-name { font-family: var(--font-display); font-size: .75rem; letter-spacing: -.01em; }
  .shot-btn:hover { color: var(--text); }
  .shot-btn[aria-current='true'] { background: var(--accent); color: var(--accent-ink); }
  .shot-btn[aria-current='true'] .mono { color: var(--accent-ink); }

  /* ===== المسرح ===== */
  .stage { height: 700vh; position: relative; }
  .scene {
    position: sticky; top: 0; height: 100vh;
    perspective: 900px;              /* أقل = منظور أقوى وأكثر دراما */
    perspective-origin: 50% 50%;
    overflow: hidden;
  }
  .world {
    position: absolute; left: 50%; top: 50%;
    width: 0; height: 0;
    transform-style: preserve-3d;
  }

  .card { position: absolute; left: 0; top: 0; will-change: transform, filter; }
  .thumb {
    position: relative; background: var(--surface-1);
    border: 1px solid var(--line);
  }
  .thumb::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(135deg, rgba(245,245,245,.055), transparent 46%);
  }
  .card.is-focus .thumb { border-color: var(--accent); }
  .ar { position: absolute; left: 8px; bottom: 7px; font-size: 11px; }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-3); padding-top: 11px; }
  .meta strong { font-family: var(--font-display); font-size: 1.35rem; letter-spacing: -.02em; }
  .meta .mono { font-size: 11px; }

  .hud { position: absolute; left: 50%; top: var(--s-6); transform: translateX(-50%); z-index: 20; }

  .after { padding-block: var(--s-8); border-top: 1px solid var(--line); }
  .after h2 { font-size: var(--t-h1); }
  .lede { color: var(--text-dim); max-width: 60ch; text-align: start; margin-top: var(--s-4); }

  @media (max-width: 760px) {
    .scene { perspective: 620px; }
    .shotbar { bottom: var(--s-6); max-width: calc(100vw - 16px); overflow-x: auto; }
    .shot-btn { padding: 6px 9px; }
    .shot-name { font-size: .7rem; }
    .meta strong { font-size: 1rem; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const world = document.querySelector<HTMLElement>('#world')!;
  const cards = gsap.utils.toArray<HTMLElement>('.card');
  const hud = document.querySelector<HTMLElement>('#hud')!;
  const buttons = gsap.utils.toArray<HTMLButtonElement>('.shot-btn');

  // الكاميرا بتبص على نقطة (الهدف) من مسافة معينة.
  // الدوران بيحصل حوالين الهدف نفسه مش حوالين الكاميرا — ده اللي بيخلي
  // اللقطة المركّز عليها تفضل في نص الفريم مهما كان الميل.
  // التقريب الناتج = perspective / (perspective - d). يعني نفس الـd بيدي
  // تقريب أكبر لما الـperspective تقل. عشان كده بنضرب المسافات في نسبة
  // الـperspective، فالتكوين يفضل واحد على كل المقاسات.
  const PERSP = innerWidth < 760 ? 620 : 900;   // لازم تطابق الـCSS
  const k = PERSP / 900;
  const FOCUS_D = 330 * k;   // مسافة المشاهدة للقطة المركّز عليها
  const OPEN_D = 470 * k;    // اللقطة الافتتاحية: أقرب، الـReel بيملا الفريم
  const WIDE_D = -800 * k;   // اللقطة الواسعة: بعيد، الفراغ كله باين

  // الفراغ متصمم على 1280px. على الشاشة الأضيق بنصغّره كله بنفس النسبة.
  const fit = Math.min(1, innerWidth / 1280);

  type Shot = { el: HTMLElement; x: number; y: number; z: number; w: number };
  const shots: Shot[] = cards.map((el) => ({
    el,
    x: Number(el.dataset.x) * fit,
    y: Number(el.dataset.y) * fit,
    z: Number(el.dataset.z) * fit,
    w: Number(el.dataset.w) * fit,
  }));

  shots.forEach((s) => {
    s.el.style.width = `${s.w}px`;
    gsap.set(s.el, { xPercent: -50, yPercent: -50, x: s.x, y: s.y, z: s.z });
  });

  // ===== نقاط توقف الكاميرا =====
  // 0 = قريب على الـReel · 1 = لقطة واسعة · 2.. = كل لقطة بالترتيب
  const waypoints = [
    { tx: shots[0].x, ty: shots[0].y, tz: shots[0].z, d: OPEN_D, rx: 0, ry: 0 },
    { tx: 0, ty: 80 * fit, tz: -1100 * fit, d: WIDE_D, rx: 0, ry: 0 },
    ...shots.map((s) => ({ tx: s.x, ty: s.y, tz: s.z, d: FOCUS_D, rx: 0, ry: 0 })),
  ];

  // الكاميرا بتميل في اتجاه حركتها — ده اللي بيدي إحساس إن فيه كاميرا أصلًا
  for (let i = 1; i < waypoints.length; i++) {
    const dx = waypoints[i].tx - waypoints[i - 1].tx;
    const dy = waypoints[i].ty - waypoints[i - 1].ty;
    waypoints[i].ry = gsap.utils.clamp(-16, 16, -dx / 70);
    waypoints[i].rx = gsap.utils.clamp(-10, 10, dy / 95);
  }

  const cam = { ...waypoints[0] };
  const rad = (d: number) => (d * Math.PI) / 180;

  const applyCamera = () => {
    world.style.transform =
      `translateZ(${cam.d}px) rotateX(${cam.rx}deg) rotateY(${cam.ry}deg) ` +
      `translate3d(${-cam.tx}px, ${-cam.ty}px, ${-cam.tz}px)`;

    // نفس حساب المتصفح، عشان نعرف عمق كل كارت بعد الدوران ونحط التمويه الصح.
    const sy = Math.sin(rad(cam.ry)), cy = Math.cos(rad(cam.ry));
    const sx = Math.sin(rad(cam.rx)), cx = Math.cos(rad(cam.rx));

    shots.forEach((s) => {
      const px = s.x - cam.tx, py = s.y - cam.ty, pz = s.z - cam.tz;
      const z1 = -px * sy + pz * cy;        // بعد rotateY
      const eff = py * sx + z1 * cx + cam.d; // بعد rotateX والمسافة
      // بنقرّب لـ0.5px عشان مانجبرش المتصفح يعيد الرسم على كل جزء من بكسل
      const b = Math.round(Math.min(Math.abs(eff - cam.d) / (430 * k), 6) * 2) / 2;
      if (s.el.dataset.b !== String(b)) {
        s.el.style.filter = b ? `blur(${b}px)` : 'none';
        s.el.dataset.b = String(b);
      }
    });
  };

  const setCurrent = (i: number) => {
    buttons.forEach((b, bi) => b.setAttribute('aria-current', String(bi === i - 2)));
    shots.forEach((s, si) => s.el.classList.toggle('is-focus', si === i - 2));
  };

  applyCamera();

  if (reduced) {
    Object.assign(cam, waypoints[1]);
    applyCamera();
    gsap.set(hud, { opacity: 0 });
  } else {
    const segs = waypoints.length - 1;
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '.stage',
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1.1,
        onUpdate: (self) => setCurrent(Math.round(self.progress * segs)),
      },
    });

    for (let i = 1; i < waypoints.length; i++) {
      tl.to(cam, {
        ...waypoints[i],
        duration: 1,
        // inOut: الحركة بتبدأ وتقف بهدوء، زي حركة كاميرا حقيقية
        ease: i === 1 ? 'power2.inOut' : 'power3.inOut',
        onUpdate: applyCamera,
      });
    }

    tl.to(hud, { opacity: 0, duration: 0.3, ease: 'none' }, 0);

    // ===== التنقّل =====
    // الكليك والأسهم بيحركوا السكرول، فالسكرول يفضل هو المصدر الوحيد للحقيقة
    const stage = document.querySelector<HTMLElement>('.stage')!;
    let idx = 0;
    const goTo = (i: number) => {
      idx = gsap.utils.clamp(0, segs, i);
      const y = stage.offsetTop + (stage.offsetHeight - innerHeight) * (idx / segs);
      const lenis = (window as any).__lenis;
      if (lenis) lenis.scrollTo(y, { duration: 1.5 });
      else scrollTo({ top: y, behavior: 'smooth' });
    };

    buttons.forEach((b) => b.addEventListener('click', () => goTo(Number(b.dataset.go) + 1)));
    cards.forEach((c, i) => c.addEventListener('click', () => goTo(i + 2)));

    addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      goTo(idx + (e.key === 'ArrowRight' ? 1 : -1));
    });
    ScrollTrigger.create({
      trigger: '.stage', start: 'top top', end: 'bottom bottom',
      onUpdate: (self) => { idx = Math.round(self.progress * segs); },
    });
  }

  const tc = document.querySelector<HTMLElement>('#tc')!;
  const pad = (n: number) => String(Math.floor(n)).padStart(2, '0');
  ScrollTrigger.create({
    trigger: document.body, start: 'top top', end: 'bottom bottom',
    onUpdate: (self) => {
      const t = self.progress * 84;
      tc.textContent = `00:${pad(t / 60)}:${pad(t % 60)}:${pad((t * 25) % 25)}`;
    },
  });
</script>
