---
import Base from '../layouts/Base.astro';

// كل كارت ليه عمق حقيقي (z بالبكسل). الكاميرا بترجع لورا فالكروت
// بتتقارب ناحية نقطة التلاشي — بالظبط زي dolly out في اللقطة.
// x/y برّه الشاشة في البداية عشان تدخل الفريم مع رجوع الكاميرا.
const cards = [
  { id: 'reel',    label: 'Reel 2026', meta: '01:24',          x: 50,  y: 48,  z: -250,  w: 50, ar: '16 / 9' },
  { id: 'motion',  label: 'Motion',    meta: '18 projects',    x: -6,  y: 17,  z: -800,  w: 26, ar: '1 / 1'  },
  { id: 'ai',      label: 'AI',        meta: '06 projects',    x: 108, y: 21,  z: -1150, w: 18, ar: '9 / 16' },
  { id: 'edit',    label: 'Edit',      meta: '11 projects',    x: -12, y: 86,  z: -1000, w: 30, ar: '16 / 9' },
  { id: 'about',   label: 'About',     meta: 'Cairo / Riyadh', x: 112, y: 84,  z: -1500, w: 24, ar: '1 / 1'  },
  { id: 'contact', label: 'Contact',   meta: 'Available',      x: 50,  y: 126, z: -1900, w: 28, ar: '16 / 9' },
];
const FOCAL = -250; // مستوى التركيز في البداية = الـReel
---

<Base title="Camera — Planet Motion">
  <div class="furniture">
    <span class="mono tl">Planet<br />Motion</span>
    <span class="mono tr">Menu</span>
    <span class="mono bl"><i class="dot"></i> Available</span>
    <span class="mono br" id="tc">00:00:00:00</span>
  </div>

  <section class="stage">
    <div class="scene">
      <div class="world" id="world">
        {cards.map((c) => (
          <div
            class="card"
            id={`c-${c.id}`}
            data-z={c.z}
            style={`left:${c.x}%; top:${c.y}%; width:${c.w}%;`}
          >
            <div class="thumb" style={`aspect-ratio:${c.ar}`}>
              <span class="ar mono">{c.ar.replace(/ /g, '')}</span>
            </div>
            <div class="meta">
              <strong>{c.label}</strong>
              <span class="mono">{c.meta}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="hint mono" id="hint">Scroll — camera pulls back</div>
  </section>

  <section class="after wrap">
    <h2 data-reveal><span class="line-mask"><span>Selected work</span></span></h2>
    <p class="lede" dir="rtl">الصفحة بتكمّل طبيعي بعد ما الكاميرا توقف.</p>
  </section>
</Base>

<style>
  .furniture { position: fixed; inset: 0; z-index: 50; pointer-events: none; }
  .furniture span { position: absolute; }
  .tl { top: var(--s-4); left: var(--s-4); line-height: 1.3; color: var(--text); }
  .tr { top: var(--s-4); right: var(--s-4); }
  .bl { bottom: var(--s-4); left: var(--s-4); display: flex; align-items: center; gap: var(--s-2); }
  .br { bottom: var(--s-4); right: var(--s-4); }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: pulse 2.4s infinite; }
  @keyframes pulse { 0%,100% { opacity: 1 } 50% { opacity: .25 } }

  /* المسرح: شاشتين سكرول للحركة كلها */
  .stage { height: 260vh; position: relative; }

  /* نقطة التلاشي. ده اللي بيخلي العمق حقيقي مش تكبير. */
  .scene {
    position: sticky; top: 0; height: 100vh;
    perspective: 1200px;
    perspective-origin: 50% 46%;
    overflow: hidden;
  }
  .world { position: absolute; inset: 0; transform-style: preserve-3d; }

  .card { position: absolute; will-change: transform, filter; }
  .thumb {
    position: relative; background: var(--surface-1);
    border: 1px solid var(--line);
  }
  /* لمعة خفيفة على حرف الكارت — بتساعد العين تقرا العمق */
  .thumb::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(245,245,245,.05), transparent 45%);
    pointer-events: none;
  }
  .ar { position: absolute; left: 7px; bottom: 6px; font-size: 10px; }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-2); padding-top: 9px; }
  .meta strong { font-family: var(--font-display); font-size: 1rem; letter-spacing: -.01em; }
  .meta .mono { font-size: 10px; }

  .hint {
    position: absolute; bottom: var(--s-6); left: 50%; transform: translateX(-50%);
    z-index: 20;
  }

  .after { padding-block: var(--s-8); border-top: 1px solid var(--line); }
  .after h2 { font-size: var(--t-h1); }
  .lede { color: var(--text-dim); max-width: 60ch; text-align: start; margin-top: var(--s-4); }

  @media (max-width: 760px) {
    .stage { height: 220vh; }
    .scene { perspective: 760px; }
    .meta strong { font-size: .8rem; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const world = document.querySelector<HTMLElement>('#world')!;
  const cards = gsap.utils.toArray<HTMLElement>('.card');
  const hint = document.querySelector<HTMLElement>('#hint')!;

  const FOCAL = -250;
  // على الشاشة الضيقة الكارت بيملا الشاشة بالكامل عند نفس قيمة الكاميرا،
  // فالفريم الأول بيبقى مساحة لون من غير معنى. بنرجّع الكاميرا لورا شوية.
  const narrow = innerWidth < 760;
  const CAM_START = narrow ? 430 : 850;  // الكاميرا جوّه المشهد، قريبة على الـReel
  const CAM_END = narrow ? -60 : -120;   // رجعت لورا، المشهد كله باين

  // التمركز بـGSAP مش CSS: لو حطينا translate(-50%,-50%) في الـCSS،
  // GSAP بيقراها كبكسل وبتتجمع مع أي x/y بنحركه.
  gsap.set(cards, { xPercent: -50, yPercent: -50 });
  cards.forEach((c) => gsap.set(c, { z: Number(c.dataset.z) }));

  // التمويه بيتحسب من بُعد الكارت عن مستوى التركيز.
  // في البداية الـReel بس هو الحاد؛ مع رجوع الكاميرا كله بيوضح (rack focus).
  const blurStart = (z: number) => Math.min(Math.abs(z - FOCAL) / (narrow ? 420 : 300), narrow ? 5 : 8);
  const blurEnd = (z: number) => Math.min(Math.abs(z - FOCAL) / 1600, 1.4);

  if (reduced) {
    gsap.set(world, { z: CAM_END });
    gsap.set(hint, { opacity: 0 });
  } else {
    gsap.set(world, { z: CAM_START, rotateY: 1.6, rotateX: -0.8 });
    cards.forEach((c) => gsap.set(c, { filter: `blur(${blurStart(Number(c.dataset.z))}px)` }));

    const tl = gsap.timeline({
      scrollTrigger: { trigger: '.stage', start: 'top top', end: '+=180%', scrub: 1 },
    });

    // الكاميرا: dolly out + تسوية الميل. ease واحد على الحركة كلها
    // عشان الإحساس يبقى حركة واحدة مش حركات متفرقة.
    tl.to(world, { z: CAM_END, rotateY: 0, rotateX: 0, ease: 'power1.inOut', duration: 1 }, 0);

    // Rack focus — بيخلص قبل الكاميرا شوية فالمشهد يستقر واضح
    cards.forEach((c) => {
      tl.to(
        c,
        { filter: `blur(${blurEnd(Number(c.dataset.z))}px)`, ease: 'power2.out', duration: 0.75 },
        0.08,
      );
    });

    tl.to(hint, { opacity: 0, duration: 0.12, ease: 'none' }, 0);
  }

  const tc = document.querySelector<HTMLElement>('#tc')!;
  const pad = (n: number) => String(Math.floor(n)).padStart(2, '0');
  ScrollTrigger.create({
    trigger: document.body,
    start: 'top top',
    end: 'bottom bottom',
    onUpdate: (self) => {
      const t = self.progress * 84;
      tc.textContent = `00:${pad(t / 60)}:${pad(t % 60)}:${pad((t * 25) % 25)}`;
    },
  });
</script>
