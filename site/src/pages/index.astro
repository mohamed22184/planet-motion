---
import Base from '../layouts/Base.astro';

const swatches = [
  { role: 'Background — Ink',  hex: '#140F0D', note: 'مشتق من بنّيك، مش أسود صريح', pct: '70%' },
  { role: 'Surface 1',         hex: '#1E1613', note: 'كارت / قسم مرفوع',            pct: '10%' },
  { role: 'Surface 2',         hex: '#3E2723', note: 'مينيو، hover — لونك',          pct: '5%'  },
  { role: 'Line',              hex: '#4E342E', note: 'براويز الجريد — لونك',         pct: '—'   },
  { role: 'Text',              hex: '#F5F5F5', note: 'لونك',                         pct: '8%'  },
  { role: 'Text dim',          hex: '#D7CCC8', note: 'لونك',                         pct: '4%'  },
  { role: 'Text mute',         hex: '#8D7E76', note: 'credits / timecode',           pct: '2%'  },
  { role: 'Accent',            hex: '#E65100', note: 'لونك — أقل من 3%',             pct: '<3%' },
  { role: 'Accent pressed',    hex: '#BF360C', note: 'لونك — الـwipe',               pct: '—'   },
];

const durations = [
  { name: 'Fast',   val: '.4s',  use: 'هوفر' },
  { name: 'Medium', val: '.8s',  use: 'دخول عناصر' },
  { name: 'Slow',   val: '1.2s', use: 'انتقال صفحات' },
];

const ratios = [
  { label: '16:9', ar: '16 / 9', tc: '00:00:04:12' },
  { label: '1:1',  ar: '1 / 1',  tc: '00:00:02:08' },
  { label: '9:16', ar: '9 / 16', tc: '00:00:06:21' },
];
---

<Base title="Theme Test — Mohamed">
  <!-- ===== HERO ===== -->
  <header class="hero wrap">
    <div class="status mono"><i></i> Available for work</div>

    <h1 data-reveal>
      <span class="line-mask"><span>Video editor</span></span>
      <span class="line-mask"><span><em>&amp;</em> motion designer</span></span>
    </h1>

    <p class="sub mono">Cairo / Riyadh — Theme test v1 · Direction A: Warm Cinema</p>
  </header>

  <!-- ===== COLORS ===== -->
  <section class="wrap sec">
    <h2 class="sec-h" data-reveal><span class="line-mask"><span>01 — Color</span></span></h2>
    <div class="swatches" data-stagger>
      {swatches.map((s) => (
        <div class="sw">
          <div class="chip" style={`background:${s.hex}`}></div>
          <div class="sw-meta">
            <strong>{s.role}</strong>
            <span class="mono">{s.hex} · {s.pct}</span>
            <span class="note" dir="rtl">{s.note}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== TYPE ===== -->
  <section class="wrap sec">
    <h2 class="sec-h" data-reveal><span class="line-mask"><span>02 — Type</span></span></h2>
    <div class="type-spec" data-stagger>
      <div class="spec">
        <span class="mono">Display — Cabinet Grotesk 800</span>
        <p class="s-hero">Reel 2026</p>
      </div>
      <div class="spec">
        <span class="mono">Editorial accent — Instrument Serif italic</span>
        <p class="s-serif">selected work</p>
      </div>
      <div class="spec">
        <span class="mono">Body — Geist</span>
        <p class="s-body">العميل بيقرر في ثواني. أقوى شغل لازم يبان فورًا من غير أي احتكاك — ده الفرق بين موقع حلو وموقع ياخد جوايز.</p>
      </div>
      <div class="spec">
        <span class="mono">Arabic — IBM Plex Sans Arabic</span>
        <p class="s-body ar">مونتير فيديو ومصمم موشن — القاهرة / الرياض</p>
      </div>
      <div class="spec">
        <span class="mono">Credits — Geist Mono</span>
        <p class="s-mono">CLIENT: ——— · ROLE: LEAD ANIMATOR · 2026 · AE / PR</p>
      </div>
    </div>
  </section>

  <!-- ===== MOTION ===== -->
  <section class="wrap sec">
    <h2 class="sec-h" data-reveal><span class="line-mask"><span>03 — Motion</span></span></h2>
    <p class="lede" dir="rtl">عدّي بالماوس على الكروت — كل واحد بمدة مختلفة. حِس الفرق واختار الإيقاع.</p>
    <div class="durs" data-stagger>
      {durations.map((d) => (
        <div class="dur" style={`--d:${d.val}`}>
          <strong>{d.name}</strong>
          <span class="mono"><span dir="ltr">{d.val}</span> · <span dir="rtl">{d.use}</span></span>
          <div class="bar"><i></i></div>
        </div>
      ))}
    </div>
    <p class="mono ease-note">ease: cubic-bezier(0.16, 1, 0.30, 1) — expo-out</p>
  </section>

  <!-- ===== GRID ===== -->
  <section class="wrap sec">
    <h2 class="sec-h" data-reveal><span class="line-mask"><span>04 — Work grid</span></span></h2>
    <p class="lede" dir="rtl">جريد قايم على نسب الفيديو، كورنرز حادة، وtimecode — ده الشكل اللي مايبانش معمول بـAI.</p>
    <div class="grid" data-stagger>
      {ratios.map((r) => (
        <article class="card">
          <div class="thumb" style={`aspect-ratio:${r.ar}`}>
            <span class="tc mono">{r.tc}</span>
            <span class="ratio mono">{r.label}</span>
            <span class="play mono">Play</span>
          </div>
          <div class="card-meta">
            <strong>Project title</strong>
            <span class="mono">Client · Lead animator · 2026</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer class="wrap sec foot">
    <h2 class="big" data-reveal><span class="line-mask"><span>Let's talk</span></span></h2>
    <a class="btn" href="#">Contact</a>
  </footer>
</Base>

<style>
  /* ===== HERO ===== */
  .hero { padding: var(--s-8) 0 var(--s-7); }
  .status { display: flex; align-items: center; gap: var(--s-2); margin-bottom: var(--s-5); }
  .status i {
    width: 7px; height: 7px; background: var(--accent);
    border-radius: 50%; animation: pulse 2.4s infinite;
  }
  @keyframes pulse { 0%,100% { opacity: 1 } 50% { opacity: .3 } }

  h1 { font-size: var(--t-hero); }
  h1 em { font-family: var(--font-display); font-style: normal; color: var(--accent); }
  .sub { margin-top: var(--s-4); }

  /* ===== SECTIONS ===== */
  .sec { padding-block: var(--s-7); border-top: 1px solid var(--line); }
  .sec-h { font-size: var(--t-h2); margin-bottom: var(--s-5); }
  .lede { color: var(--text-dim); max-width: 60ch; text-align: start; margin: calc(var(--s-4) * -1) 0 var(--s-5); }

  /* ===== COLORS ===== */
  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--s-3); }
  .sw { border: 1px solid var(--line); }
  .chip { height: 110px; }
  .sw-meta { padding: var(--s-3); display: grid; gap: 4px; background: var(--surface-1); }
  .sw-meta strong { font-size: var(--t-small); }
  .note { font-size: var(--t-small); color: var(--text-dim); }

  /* ===== TYPE ===== */
  .type-spec { display: grid; gap: var(--s-6); }
  .spec { display: grid; gap: var(--s-2); padding-top: var(--s-3); border-top: 1px solid var(--line); }
  .s-hero  { font-family: var(--font-display); font-size: var(--t-h1); line-height: .9; letter-spacing: -.04em; margin: 0; }
  .s-serif { font-family: 'Instrument Serif', serif; font-style: italic; font-size: var(--t-h1); line-height: 1; margin: 0; color: var(--text-dim); }
  .s-body  { max-width: 60ch; margin: 0; }
  .s-body.ar { font-family: var(--font-ar); direction: rtl; font-size: 1.25rem; }
  .s-mono  { font-family: var(--font-mono); font-size: .875rem; letter-spacing: .06em; color: var(--text-mute); margin: 0; }

  /* ===== MOTION ===== */
  .durs { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--s-3); }
  .dur {
    padding: var(--s-4); border: 1px solid var(--line); background: var(--surface-1);
    display: grid; gap: var(--s-2); cursor: pointer;
    transition: background var(--d) var(--ease-out), transform var(--d) var(--ease-out);
  }
  .dur:hover { background: var(--surface-2); transform: translateY(-6px); }
  .bar { height: 2px; background: var(--line); margin-top: var(--s-2); }
  .bar i { display: block; height: 100%; width: 0; background: var(--accent); transition: width var(--d) var(--ease-out); }
  .dur:hover .bar i { width: 100%; }
  .ease-note { margin-top: var(--s-4); }

  /* ===== GRID ===== */
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--s-3); align-items: start; }
  .card { cursor: pointer; }
  .thumb {
    position: relative; background: var(--surface-1);
    border: 1px solid var(--line); overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .card:hover .thumb { border-color: var(--accent); }
  .tc    { position: absolute; top: var(--s-2);    left: var(--s-2); }
  .ratio { position: absolute; bottom: var(--s-2); left: var(--s-2); }
  .play {
    position: absolute; inset: 0; display: grid; place-content: center;
    color: var(--accent); opacity: 0; letter-spacing: .2em;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .card:hover .play { opacity: 1; }
  .card-meta { display: grid; gap: 4px; padding-top: var(--s-3); }

  /* ===== FOOTER ===== */
  .foot { padding-block: var(--s-8); }
  .big { font-size: var(--t-hero); }
  .btn {
    display: inline-block; margin-top: var(--s-5);
    padding: var(--s-3) var(--s-5); background: var(--accent); color: var(--accent-ink);
    text-decoration: none; font-weight: 600; letter-spacing: .02em;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .btn:hover { background: var(--accent-press); color: var(--text); }

  @media (max-width: 640px) {
    .hero { padding-top: var(--s-7); }
    .wrap { width: min(1440px, 100% - var(--s-3) * 2); }
  }
</style>
