---
import Base from '../layouts/Base.astro';
import { marks } from '../data/marks';
---

<Base title="Logo marks — Planet Motion">
  <main class="wrap page" id="main" tabindex="-1">
    <header>
      <a class="mono back" href="/">← Planet Motion</a>
      <h1 data-reveal><span class="line-mask"><span>Logo marks</span></span></h1>
      <p class="lede" dir="rtl">
        أربع علامات. كلها بلون واحد وعلى نفس الشبكة.
        <strong>احكم من عمود 16px</strong> — ده المقاس اللي هيظهر بيه في تاب
        المتصفح وفي توقيع الإيميل، واللي بيسقّط أي فكرة فيها تفاصيل زيادة.
      </p>
    </header>

    {marks.map((m, i) => (
      <section class="mark">
        <div class="head">
          <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
          <h2>{m.name}</h2>
        </div>

        <div class="sizes">
          <div class="big">
            <svg viewBox="0 0 24 24" set:html={m.svg} aria-hidden="true"></svg>
          </div>
          <div class="small">
            {[48, 32, 16].map((px) => (
              <figure>
                <svg viewBox="0 0 24 24" style={`width:${px}px;height:${px}px`} set:html={m.svg} aria-hidden="true"></svg>
                <figcaption class="mono">{px}px</figcaption>
              </figure>
            ))}
            <figure class="onlight">
              <svg viewBox="0 0 24 24" style="width:32px;height:32px" set:html={m.svg} aria-hidden="true"></svg>
              <figcaption class="mono">on light</figcaption>
            </figure>
          </div>
          <div class="lockup">
            <svg viewBox="0 0 24 24" set:html={m.svg} aria-hidden="true"></svg>
            <span>Planet<br />Motion</span>
          </div>
        </div>

        <div class="notes">
          <p dir="rtl">{m.idea}</p>
          <p class="motion mono" dir="rtl">الحركة: {m.motion}</p>
        </div>
      </section>
    ))}

    <!-- ===== النسخة الكاملة =====
         الأحزمة مقصوصة بـclipPath، والـid هنا آمن لأن النسخة دي
         بتترسم مرة واحدة في الصفحة (عكس علامات جدول المقاسات). -->
    <section class="full">
      <div class="head">
        <span class="mono n">—</span>
        <h2>Planet · full</h2>
      </div>

      <div class="full-row">
        <svg class="jupiter" viewBox="0 0 200 200" role="img" aria-label="Planet Motion">
          <defs>
            <clipPath id="pm-globe"><circle cx="100" cy="100" r="54" /></clipPath>

            <!-- جسم الكوكب: النور من فوق شمال -->
            <radialGradient id="pm-body" cx="33%" cy="27%" r="78%">
              <stop offset="0%"   stop-color="#B06A3C" />
              <stop offset="42%"  stop-color="#6E3C24" />
              <stop offset="78%"  stop-color="#3A2018" />
              <stop offset="100%" stop-color="#180F0C" />
            </radialGradient>

            <!-- الظل اللي بيلفّ لتحت يمين — ده اللي بيدي الكروية -->
            <radialGradient id="pm-shade" cx="31%" cy="25%" r="82%">
              <stop offset="0%"   stop-color="#FFFFFF" stop-opacity=".10" />
              <stop offset="46%"  stop-color="#140F0D" stop-opacity="0" />
              <stop offset="100%" stop-color="#0B0706" stop-opacity=".88" />
            </radialGradient>

            <!-- ضوء الحافة: قوي ناحية النور وبيختفي ناحية الظل -->
            <linearGradient id="pm-rim" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%"   stop-color="#E8A06A" stop-opacity=".75" />
              <stop offset="45%"  stop-color="#E8A06A" stop-opacity="0" />
              <stop offset="100%" stop-color="#E8A06A" stop-opacity="0" />
            </linearGradient>

            <!-- الأحزمة: turbulence بيموّجها زي سحب المشتري، وبعدين
                 تمويه بسيط عشان تتداخل مع بعض بدل ما تبقى شرايط حادة -->
            <filter id="pm-bands" x="-25%" y="-25%" width="150%" height="150%">
              <feTurbulence type="fractalNoise" baseFrequency="0.013 0.09"
                            numOctaves="4" seed="9" result="n" />
              <feDisplacementMap in="SourceGraphic" in2="n" scale="26"
                                 xChannelSelector="R" yChannelSelector="G" />
              <feGaussianBlur stdDeviation="2.6" />
            </filter>

            <filter id="pm-spot" x="-50%" y="-50%" width="200%" height="200%">
              <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed="3" result="n" />
              <feDisplacementMap in="SourceGraphic" in2="n" scale="9"
                                 xChannelSelector="R" yChannelSelector="G" />
              <feGaussianBlur stdDeviation="1.6" />
            </filter>
          </defs>

          <!-- النص البعيد من الحزام — ورا الكوكب -->
          <g fill="#9A8A82">
            <path d="M0.0 128.1L5.2 127.0L3.1 130.1L6.2 132.2L1.1 133.2L3.1 130.1Z" opacity="0.82"/>
            <path d="M12.4 121.5L19.4 122.6L15.3 125.5L18.2 129.5L11.3 128.4L15.3 125.5Z" opacity="0.69"/>
            <path d="M-0.4 125.8L5.7 123.9L3.6 127.9L7.6 130.1L1.5 132.0L3.6 127.9Z" opacity="0.69"/>
            <path d="M1.5 122.1L8.1 121.4L5.2 125.0L8.9 128.0L2.3 128.7L5.2 125.0Z" opacity="0.77"/>
            <path d="M15.2 113.7L20.4 115.5L16.9 117.2L18.6 120.7L13.4 118.9L16.9 117.2Z" opacity="0.92"/>
