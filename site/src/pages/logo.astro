            <path d="M178.8 78.2L187.0 80.8L181.6 83.6L184.5 89.1L176.2 86.5L181.6 83.6Z" opacity="0.62"/>
            <path d="M188.1 77.8L194.8 80.3L190.2 82.3L192.3 86.9L185.7 84.4L190.2 82.3Z" opacity="0.8"/>
            <path d="M174.3 86.8L180.7 85.2L178.3 89.2L182.3 91.6L175.9 93.2L178.3 89.2Z" opacity="0.87"/>
            <path d="M173.1 88.3L178.9 85.8L177.2 90.0L181.4 91.6L175.6 94.1L177.2 90.0Z" opacity="0.77"/>
            <path d="M171.7 88.8L179.0 88.5L175.5 92.3L179.3 95.8L172.0 96.1L175.5 92.3Z" opacity="0.98"/>
            <path d="M150.1 103.6L159.4 100.6L156.3 106.8L162.5 109.9L153.2 113.0L156.3 106.8Z" opacity="0.53"/>
            <path d="M142.3 111.4L149.5 109.1L147.0 113.9L151.8 116.3L144.6 118.6L147.0 113.9Z" opacity="0.86"/>
