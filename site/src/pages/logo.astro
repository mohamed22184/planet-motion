            <path d="M37.6 133.0L45.1 134.7L40.5 137.6L43.4 142.3L35.8 140.5L40.5 137.6Z" opacity="0.63"/>
            <path d="M22.2 134.9L29.9 136.8L25.1 139.7L28.1 144.5L20.3 142.7L25.1 139.7Z" opacity="0.95"/>
            <path d="M14.2 133.1L21.7 136.4L16.3 138.5L18.4 143.9L10.9 140.6L16.3 138.5Z" opacity="0.64"/>
            <path d="M10.0 133.7L18.1 133.0L14.3 137.4L18.7 141.1L10.6 141.8L14.3 137.4Z" opacity="0.88"/>
