            <path d="M82.6 128.7L90.2 125.1L88.2 130.7L93.9 132.8L86.2 136.4L88.2 130.7Z" opacity="0.55"/>
            <path d="M75.6 131.9L82.7 130.9L79.6 134.9L83.6 138.0L76.6 138.9L79.6 134.9Z" opacity="0.94"/>
            <path d="M65.0 133.0L74.4 133.7L69.3 138.0L73.6 143.1L64.2 142.3L69.3 138.0Z" opacity="0.53"/>
