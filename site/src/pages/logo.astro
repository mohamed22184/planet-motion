            <path d="M28.6 101.7L33.3 102.3L30.7 104.4L32.7 107.0L28.0 106.4L30.7 104.4Z" opacity="0.72"/>
            <path d="M31.3 95.9L36.3 95.7L33.9 98.3L36.5 100.6L31.6 100.8L33.9 98.3Z" opacity="0.49"/>
            <path d="M35.7 94.3L40.0 95.2L37.4 96.9L39.0 99.5L34.8 98.6L37.4 96.9Z" opacity="0.76"/>
            <path d="M35.3 94.5L39.3 93.0L38.1 95.8L40.8 97.0L36.8 98.5L38.1 95.8Z" opacity="0.7"/>
            <path d="M43.4 90.0L47.4 88.5L46.2 91.3L48.9 92.5L44.9 94.0L46.2 91.3Z" opacity="0.48"/>
