---
import Base from '../layouts/Base.astro';
import { marks } from '../data/marks';
---

<Base title="Logo marks — Planet Motion">
  <main class="wrap page" id="main" tabindex="-1">
    <header>
      <a class="mono back" href="/">← Planet Motion</a>
      <h1 data-reveal><span class="line-mask"><span>Logo marks</span></span></h1>
      <p class="lede" dir="rtl">
        أربع علامات. كلها بلون واحد وعلى نفس الشبكة.
        <strong>احكم من عمود 16px</strong> — ده المقاس اللي هيظهر بيه في تاب
        المتصفح وفي توقيع الإيميل، واللي بيسقّط أي فكرة فيها تفاصيل زيادة.
      </p>
    </header>

    {marks.map((m, i) => (
      <section class="mark">
        <div class="head">
          <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
          <h2>{m.name}</h2>
        </div>

        <div class="sizes">
          <div class="big">
            <svg viewBox="0 0 24 24" set:html={m.svg} aria-hidden="true"></svg>
          </div>
          <div class="small">
            {[48, 32, 16].map((px) => (
              <figure>
                <svg viewBox="0 0 24 24" style={`width:${px}px;height:${px}px`} set:html={m.svg} aria-hidden="true"></svg>
                <figcaption class="mono">{px}px</figcaption>
              </figure>
            ))}
            <figure class="onlight">
              <svg viewBox="0 0 24 24" style="width:32px;height:32px" set:html={m.svg} aria-hidden="true"></svg>
              <figcaption class="mono">on light</figcaption>
            </figure>
          </div>
          <div class="lockup">
            <svg viewBox="0 0 24 24" set:html={m.svg} aria-hidden="true"></svg>
            <span>Planet<br />Motion</span>
          </div>
        </div>

        <div class="notes">
          <p dir="rtl">{m.idea}</p>
          <p class="motion mono" dir="rtl">الحركة: {m.motion}</p>
        </div>
      </section>
    ))}

    <!-- ===== النسخة الكاملة =====
         الأحزمة مقصوصة بـclipPath، والـid هنا آمن لأن النسخة دي
         بتترسم مرة واحدة في الصفحة (عكس علامات جدول المقاسات). -->
    <section class="full">
      <div class="head">
        <span class="mono n">—</span>
        <h2>Planet · full</h2>
      </div>

      <div class="full-row">
        <svg class="jupiter" viewBox="0 0 200 200" role="img" aria-label="Planet Motion">
          <defs>
            <clipPath id="pm-globe"><circle cx="100" cy="100" r="54" /></clipPath>

            <!-- جسم الكوكب: النور من فوق شمال -->
            <radialGradient id="pm-body" cx="33%" cy="27%" r="78%">
              <stop offset="0%"   stop-color="#B06A3C" />
              <stop offset="42%"  stop-color="#6E3C24" />
              <stop offset="78%"  stop-color="#3A2018" />
              <stop offset="100%" stop-color="#180F0C" />
            </radialGradient>

            <!-- الظل اللي بيلفّ لتحت يمين — ده اللي بيدي الكروية -->
            <radialGradient id="pm-shade" cx="31%" cy="25%" r="82%">
              <stop offset="0%"   stop-color="#FFFFFF" stop-opacity=".10" />
              <stop offset="46%"  stop-color="#140F0D" stop-opacity="0" />
              <stop offset="100%" stop-color="#0B0706" stop-opacity=".88" />
            </radialGradient>

            <!-- ضوء الحافة: قوي ناحية النور وبيختفي ناحية الظل -->
            <linearGradient id="pm-rim" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%"   stop-color="#E8A06A" stop-opacity=".75" />
              <stop offset="45%"  stop-color="#E8A06A" stop-opacity="0" />
              <stop offset="100%" stop-color="#E8A06A" stop-opacity="0" />
            </linearGradient>

            <!-- الأحزمة: turbulence بيموّجها زي سحب المشتري، وبعدين
                 تمويه بسيط عشان تتداخل مع بعض بدل ما تبقى شرايط حادة -->
            <filter id="pm-bands" x="-25%" y="-25%" width="150%" height="150%">
              <feTurbulence type="fractalNoise" baseFrequency="0.013 0.09"
                            numOctaves="4" seed="9" result="n" />
              <feDisplacementMap in="SourceGraphic" in2="n" scale="26"
                                 xChannelSelector="R" yChannelSelector="G" />
              <feGaussianBlur stdDeviation="2.6" />
            </filter>

            <filter id="pm-spot" x="-50%" y="-50%" width="200%" height="200%">
              <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed="3" result="n" />
              <feDisplacementMap in="SourceGraphic" in2="n" scale="9"
                                 xChannelSelector="R" yChannelSelector="G" />
              <feGaussianBlur stdDeviation="1.6" />
            </filter>

            <!-- إضاءة كل كويكب لوحده: gradientUnits الافتراضي نسبة
                 لصندوق العنصر، فنفس التعريف بينوّر كل واحد من ناحيته. -->
            <linearGradient id="pm-rock" x1=".15" y1="0" x2=".85" y2="1">
              <stop offset="0%"   stop-color="#F6EFEA" />
              <stop offset="42%"  stop-color="#BBAAA1" />
              <stop offset="100%" stop-color="#4A3A33" />
            </linearGradient>
            <linearGradient id="pm-rock-mid" x1=".15" y1="0" x2=".85" y2="1">
              <stop offset="0%"   stop-color="#D8CCC5" />
              <stop offset="45%"  stop-color="#9A8A82" />
              <stop offset="100%" stop-color="#3C2E29" />
            </linearGradient>
            <linearGradient id="pm-rock-far" x1=".15" y1="0" x2=".85" y2="1">
              <stop offset="0%"   stop-color="#9F928B" />
              <stop offset="50%"  stop-color="#6B5D57" />
              <stop offset="100%" stop-color="#2A211E" />
            </linearGradient>
            <linearGradient id="pm-rock-hot" x1=".15" y1="0" x2=".85" y2="1">
              <stop offset="0%"   stop-color="#FFA15C" />
              <stop offset="45%"  stop-color="#E65100" />
              <stop offset="100%" stop-color="#7A2A06" />
            </linearGradient>

            <!-- تكسير الحواف: نفس منطق أحزمة الكوكب بس بمقياس أصغر
                 بكتير، عشان شكل الساعة الرملية يفضل مقروء -->
            <filter id="pm-rough" x="-30%" y="-30%" width="160%" height="160%">
              <feTurbulence type="fractalNoise" baseFrequency="0.22"
                            numOctaves="3" seed="4" result="n" />
              <feDisplacementMap in="SourceGraphic" in2="n" scale="2.2"
                                 xChannelSelector="R" yChannelSelector="G" />
            </filter>
            <!-- البعيد: نفس التكسير + تمويه خفيف = عمق ميدان -->
            <filter id="pm-rough-far" x="-40%" y="-40%" width="180%" height="180%">
              <feTurbulence type="fractalNoise" baseFrequency="0.22"
                            numOctaves="3" seed="4" result="n" />
              <feDisplacementMap in="SourceGraphic" in2="n" scale="2.2"
                                 xChannelSelector="R" yChannelSelector="G" />
              <feGaussianBlur stdDeviation="1.1" />
            </filter>
          </defs>

          <!-- الحزام البعيد — ورا الكوكب، أغمق ومموّه -->
          <g fill="url(#pm-rock-far)" filter="url(#pm-rough-far)" opacity=".75">
              <path d="M1.5 125.7L7.5 127.9L3.4 129.8L5.3 133.9L-0.7 131.7L3.4 129.8Z"/>
              <path d="M0.1 126.0L6.9 125.1L4.0 129.0L7.9 131.9L1.1 132.8L4.0 129.0Z"/>
              <path d="M6.5 122.8L12.0 123.7L8.8 126.0L11.1 129.2L5.6 128.3L8.8 126.0Z"/>
              <path d="M-1.8 123.2L4.9 122.3L2.0 126.1L5.8 129.0L-0.9 129.9L2.0 126.1Z"/>
              <path d="M8.3 114.5L13.6 116.8L9.9 118.3L11.4 122.0L6.1 119.8L9.9 118.3Z"/>
              <path d="M22.9 105.3L27.7 105.9L25.0 108.0L27.2 110.8L22.3 110.2L25.0 108.0Z"/>
              <path d="M25.4 102.6L30.6 102.5L28.0 105.2L30.7 107.8L25.4 107.8L28.0 105.2Z"/>
              <path d="M27.0 98.3L30.9 95.7L30.3 99.0L33.6 99.7L29.6 102.3L30.3 99.0Z"/>
              <path d="M31.4 97.6L35.8 95.8L34.5 98.9L37.6 100.1L33.2 102.0L34.5 98.9Z"/>
              <path d="M30.7 95.3L35.0 97.5L31.8 98.5L32.8 101.7L28.6 99.6L31.8 98.5Z"/>
              <path d="M41.1 91.0L45.6 90.7L43.5 93.1L46.0 95.2L41.4 95.6L43.5 93.1Z"/>
              <path d="M39.7 89.0L44.4 88.4L42.4 91.0L45.0 93.0L40.4 93.7L42.4 91.0Z"/>
              <path d="M58.5 84.3L62.8 84.3L60.7 86.4L62.8 88.6L58.5 88.6L60.7 86.4Z"/>
              <path d="M65.2 77.2L68.9 79.4L66.0 80.2L66.7 83.1L63.0 80.9L66.0 80.2Z"/>
              <path d="M98.3 71.4L102.3 70.3L100.8 72.9L103.4 74.3L99.4 75.5L100.8 72.9Z"/>
              <path d="M112.2 65.4L116.5 65.4L114.4 67.6L116.6 69.7L112.2 69.7L114.4 67.6Z"/>
              <path d="M120.5 60.8L124.9 60.5L122.8 62.9L125.2 65.0L120.7 65.2L122.8 62.9Z"/>
              <path d="M134.4 65.1L138.4 62.6L137.7 65.8L140.9 66.6L136.9 69.1L137.7 65.8Z"/>
              <path d="M142.3 57.9L146.6 59.4L143.6 60.8L145.0 63.7L140.7 62.1L143.6 60.8Z"/>
              <path d="M136.6 64.4L140.5 61.9L139.8 65.1L143.0 65.8L139.1 68.3L139.8 65.1Z"/>
              <path d="M144.8 61.1L148.7 58.8L147.9 61.9L151.0 62.7L147.2 65.0L147.9 61.9Z"/>
              <path d="M170.7 57.6L176.1 58.6L172.9 60.8L175.1 64.0L169.6 63.0L172.9 60.8Z"/>
              <path d="M176.0 57.4L181.4 55.3L179.7 59.1L183.5 60.8L178.0 62.8L179.7 59.1Z"/>
              <path d="M181.1 63.2L186.4 63.0L183.8 65.7L186.5 68.2L181.3 68.4L183.8 65.7Z"/>
              <path d="M185.7 62.8L191.4 61.7L189.0 65.1L192.4 67.4L186.7 68.5L189.0 65.1Z"/>
              <path d="M188.8 62.6L195.2 64.6L191.0 66.8L193.2 71.0L186.8 69.0L191.0 66.8Z"/>
              <path d="M181.0 67.0L187.5 63.6L186.0 68.5L191.0 70.0L184.5 73.5L186.0 68.5Z"/>
              <path d="M193.4 65.0L199.3 64.7L196.5 67.8L199.6 70.5L193.8 70.9L196.5 67.8Z"/>
              <path d="M188.5 66.4L194.9 66.9L191.4 69.8L194.3 73.3L187.9 72.8L191.4 69.8Z"/>
          </g>

          <!-- الكوكب -->
          <g clip-path="url(#pm-globe)">
            <circle cx="100" cy="100" r="54" fill="url(#pm-body)"/>
            <!-- الأحزمة متموّجة بالـturbulence ومموّهة عشان تتداخل -->
            <g filter="url(#pm-bands)" opacity=".62">
              <rect x="40" y="56"  width="120" height="14" fill="#2A1712"/>
              <rect x="40" y="74"  width="120" height="9"  fill="#C2561B"/>
              <rect x="40" y="88"  width="120" height="17" fill="#2A1712"/>
              <rect x="40" y="110" width="120" height="12" fill="#E65100"/>
              <rect x="40" y="128" width="120" height="15" fill="#3E2723"/>
              <rect x="40" y="146" width="120" height="8"  fill="#BF360C"/>
            </g>
            <g filter="url(#pm-spot)">
              <ellipse cx="84" cy="116" rx="19" ry="9.5" fill="#E65100" opacity=".95"/>
              <ellipse cx="84" cy="116" rx="11" ry="5"   fill="#FF7A2E" opacity=".75"/>
            </g>
            <!-- التظليل الكروي: النور من فوق شمال والظل بيتلف لتحت يمين -->
            <circle cx="100" cy="100" r="54" fill="url(#pm-shade)"/>
          </g>
          <!-- ضوء الحافة -->
          <circle cx="100" cy="100" r="53.2" fill="none"
                  stroke="url(#pm-rim)" stroke-width="1.8"/>

          <!-- الحزام القريب — قدام الكوكب، أفتح وأحد -->
          <g fill="url(#pm-rock-mid)" filter="url(#pm-rough)" opacity="1">
              <path d="M190.8 67.2L196.5 66.1L194.2 69.5L197.6 71.7L191.9 72.9L194.2 69.5Z"/>
              <path d="M194.0 69.2L199.7 67.4L197.8 71.2L201.5 73.1L195.8 74.9L197.8 71.2Z"/>
              <path d="M177.3 75.9L184.8 72.8L182.5 78.1L187.8 80.3L180.3 83.4L182.5 78.1Z"/>
              <path d="M187.3 74.4L193.5 76.2L189.5 78.5L191.8 82.5L185.5 80.7L189.5 78.5Z"/>
              <path d="M177.1 82.0L183.5 81.4L180.6 85.0L184.1 87.9L177.7 88.5L180.6 85.0Z"/>
              <path d="M177.1 79.8L186.0 83.2L179.9 85.9L182.6 92.0L173.8 88.6L179.9 85.9Z"/>
              <path d="M177.5 84.9L184.3 84.0L181.3 87.9L185.2 90.9L178.4 91.7L181.3 87.9Z"/>
              <path d="M18.8 131.6L27.8 133.3L22.4 137.0L26.1 142.4L17.0 140.7L22.4 137.0Z"/>
              <path d="M9.6 135.8L15.1 132.4L14.0 136.8L18.5 137.8L13.0 141.2L14.0 136.8Z"/>
              <path d="M23.0 127.7L29.8 131.9L24.3 133.2L25.6 138.7L18.7 134.5L24.3 133.2Z"/>
              <path d="M20.4 127.4L27.4 129.4L22.9 131.9L25.4 136.4L18.4 134.4L22.9 131.9Z"/>
              <path d="M14.9 130.6L21.0 130.9L17.8 133.8L20.7 137.0L14.6 136.7L17.8 133.8Z"/>
              <path d="M7.1 130.5L14.8 132.4L10.0 135.3L12.9 140.1L5.2 138.2L10.0 135.3Z"/>
              <path d="M3.2 126.9L9.4 128.3L5.6 130.7L8.0 134.6L1.8 133.1L5.6 130.7Z"/>
          </g>

          <g fill="url(#pm-rock)" filter="url(#pm-rough)" opacity="1">
              <path d="M184.3 84.1L189.9 87.8L185.2 88.8L186.2 93.4L180.6 89.7L185.2 88.8Z"/>
              <path d="M169.2 87.6L178.2 85.7L174.7 91.2L180.1 94.7L171.1 96.6L174.7 91.2Z"/>
              <path d="M150.4 100.7L157.5 101.4L153.6 104.6L156.8 108.5L149.7 107.7L153.6 104.6Z"/>
              <path d="M137.6 110.0L146.1 109.5L142.1 114.0L146.6 118.0L138.0 118.5L142.1 114.0Z"/>
              <path d="M141.4 106.8L150.0 110.8L143.7 113.1L146.0 119.4L137.4 115.3L143.7 113.1Z"/>
              <path d="M125.6 109.5L135.9 113.6L128.7 116.7L131.8 124.0L121.4 119.8L128.7 116.7Z"/>
              <path d="M116.9 113.7L125.9 119.0L118.8 120.8L120.6 128.0L111.6 122.7L118.8 120.8Z"/>
              <path d="M109.0 122.0L120.1 123.4L113.9 128.2L118.7 134.4L107.7 133.0L113.9 128.2Z"/>
              <path d="M91.0 123.8L97.1 127.5L92.2 128.7L93.3 133.5L87.3 129.8L92.2 128.7Z"/>
              <path d="M86.0 128.6L93.5 131.6L88.2 133.9L90.4 139.1L82.9 136.1L88.2 133.9Z"/>
              <path d="M75.1 128.9L82.5 130.9L77.8 133.6L80.5 138.3L73.1 136.3L77.8 133.6Z"/>
              <path d="M72.3 127.2L80.9 131.0L74.7 133.4L77.0 139.6L68.5 135.7L74.7 133.4Z"/>
              <path d="M29.8 135.9L39.2 132.4L36.3 138.9L42.7 141.9L33.3 145.4L36.3 138.9Z"/>
              <path d="M34.5 134.7L41.5 130.6L40.0 136.1L45.6 137.6L38.6 141.7L40.0 136.1Z"/>
              <path d="M31.3 135.1L39.0 131.5L36.9 137.2L42.6 139.2L34.9 142.9L36.9 137.2Z"/>
          </g>

          <g stroke="#8D7E76" stroke-width="1.4" fill="none">
            <path d="M189 71 L153 59"/>
            <path d="M11 129 L47 141"/>
          </g>
          <g fill="url(#pm-rock-hot)" filter="url(#pm-rough)">
            <path d="M181.4 63.0L197.4 63.0L189.4 71.0L197.4 79.0L181.4 79.0L189.4 71.0Z"/>
            <path d="M2.6 121.0L18.6 121.0L10.6 129.0L18.6 137.0L2.6 137.0L10.6 129.0Z"/>
          </g>
        </svg>

        <div class="full-notes">
          <p dir="rtl">
            الجسم مش شرايط مسطّحة: تظليل كروي (النور من فوق شمال والظل
            بيلفّ لتحت يمين) + ضوء حافة، والأحزمة متموّجة بـturbulence
            ومموّهة عشان <strong>تتداخل مع بعض</strong> زي سحب المشتري
            الحقيقية. والألوان من الباليتة نفسها.
          </p>
          <p dir="rtl">
            الكويكبات شكلها <strong>كيفريم Easy Ease</strong> — الساعة
            الرملية اللي بتطلع في After Effects لما تدوس F9، مش المعيّن
            (ده الـLinear). أي حد شغال موشن هيعرفها فورًا.
          </p>
          <p dir="rtl">
            توزيعهم <strong>عشوائي</strong>: الزوايا والمقاسات والتشتيت
            في عرض الحزام، كله عشوائي.
          </p>
          <p dir="rtl">
            وكل كويكب <strong>مجسّم بنفس منطق الكوكب</strong>: تدرّج إضاءة
            من نفس اتجاه النور فبيبقى له وش منوّر ووش في الظل، وحواف
            متكسّرة بالـturbulence. والحزام على تلات مستويات عمق —
            البعيد أغمق ومموّه، والقريب أفتح وأحد.
          </p>
          <p class="motion mono" dir="rtl">
            الحركة: الكويكبات بتوصل واحد ورا التاني من الكيفريم الأول
            للتاني، وبعدين الأحزمة بتزحف أفقيًا ببطء فالكوكب يبان بيلف.
          </p>
          <p class="warn mono" dir="rtl">
            دي للاستخدام الكبير بس — الهيرو، البريلودر، السوشيال.
            في المقاسات الصغيرة بنستخدم النسخة المبسطة فوق (علامة 01).
          </p>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .page { padding-block: var(--s-7) var(--s-8); }
  .back { text-decoration: none; color: var(--text-dim); }
  h1 { font-size: var(--t-h1); margin-top: var(--s-4); }
  .lede { max-width: 56ch; margin: var(--s-4) 0 var(--s-7); color: var(--text-dim); text-align: start; }
  .lede strong { color: var(--text); font-weight: 400; }

  .mark { padding-block: var(--s-6); border-top: 1px solid var(--line); }
  .head { display: flex; align-items: baseline; gap: var(--s-3); margin-bottom: var(--s-5); }
  .head .n { color: var(--accent); }
  .head h2 { font-size: var(--t-h2); }

  .sizes { display: grid; grid-template-columns: auto 1fr auto; gap: var(--s-6); align-items: center; }
  .big svg { width: 120px; height: 120px; color: var(--accent); }

  .small { display: flex; align-items: flex-end; gap: var(--s-5); }
  .small figure { margin: 0; display: grid; justify-items: center; gap: 9px; }
  .small svg { color: var(--text); }
  .onlight { background: var(--text); padding: 10px; }
  .onlight svg { color: var(--ink); }
  .onlight figcaption { color: var(--ink); }

  .lockup { display: flex; align-items: center; gap: 12px; }
  .lockup svg { width: 30px; height: 30px; color: var(--accent); }
  .lockup span { font-family: var(--font-mono); font-size: 11px; line-height: 1.3; letter-spacing: .08em; text-transform: uppercase; }

  .notes { margin-top: var(--s-5); display: grid; gap: var(--s-2); max-width: 70ch; }
  .notes p { margin: 0; color: var(--text-dim); }
  .notes .motion { color: var(--text-mute); }

  .full { padding-block: var(--s-6); border-top: 1px solid var(--line); }
  .full-row { display: grid; grid-template-columns: auto 1fr; gap: var(--s-6); align-items: center; }
  .jupiter { width: 260px; height: 260px; }
  .full-notes { display: grid; gap: var(--s-3); max-width: 60ch; }
  .full-notes p { margin: 0; color: var(--text-dim); }
  .full-notes strong { color: var(--text); font-weight: 400; }
  .full-notes .motion, .full-notes .warn { color: var(--text-mute); }

  @media (max-width: 760px) {
    .full-row { grid-template-columns: 1fr; }
    .jupiter { width: 180px; height: 180px; }
    .sizes { grid-template-columns: 1fr; gap: var(--s-5); }
    .big svg { width: 84px; height: 84px; }
    .small { flex-wrap: wrap; gap: var(--s-4); }
