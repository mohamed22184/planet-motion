            <path d="M11.3 129.3L17.8 132.8L12.8 134.3L14.3 139.2L7.9 135.7L12.8 134.3Z" opacity="0.93"/>
            <path d="M7.2 131.1L14.7 131.7L10.7 135.2L14.1 139.2L6.6 138.6L10.7 135.2Z" opacity="0.69"/>
            <path d="M2.9 133.2L9.6 129.8L7.9 134.9L13.0 136.5L6.3 139.9L7.9 134.9Z" opacity="0.78"/>
