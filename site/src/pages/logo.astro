            <path d="M125.0 64.1L129.1 64.6L126.8 66.4L128.6 68.7L124.5 68.2L126.8 66.4Z" opacity="0.95"/>
            <path d="M138.0 59.1L142.3 60.4L139.4 61.9L140.9 64.7L136.6 63.4L139.4 61.9Z" opacity="0.97"/>
            <path d="M139.6 58.5L143.8 59.4L141.2 61.1L142.8 63.6L138.6 62.7L141.2 61.1Z" opacity="0.9"/>
            <path d="M143.7 57.1L147.7 58.8L144.9 59.9L146.0 62.7L142.0 61.1L144.9 59.9Z" opacity="0.99"/>
            <path d="M146.2 58.0L150.7 57.2L148.9 59.8L151.5 61.6L147.0 62.4L148.9 59.8Z" opacity="0.95"/>
            <path d="M173.8 57.9L178.5 57.6L176.3 60.1L178.7 62.3L174.1 62.6L176.3 60.1Z" opacity="0.75"/>
            <path d="M178.0 57.7L182.6 59.2L179.6 60.7L181.1 63.7L176.6 62.2L179.6 60.7Z" opacity="0.49"/>
            <path d="M187.3 60.5L192.6 62.1L189.2 64.0L191.1 67.4L185.8 65.8L189.2 64.0Z" opacity="0.53"/>
            <path d="M177.5 63.7L183.4 65.8L179.4 67.7L181.3 71.7L175.5 69.6L179.4 67.7Z" opacity="0.83"/>
            <path d="M190.6 63.7L197.0 60.9L195.2 65.4L199.8 67.2L193.4 70.0L195.2 65.4Z" opacity="0.57"/>
            <path d="M185.6 64.5L192.1 65.4L188.4 68.2L191.2 71.9L184.7 71.0L188.4 68.2Z" opacity="0.74"/>
            <path d="M191.7 65.7L197.6 65.0L195.0 68.3L198.3 70.9L192.4 71.6L195.0 68.3Z" opacity="0.91"/>
            <path d="M194.6 63.6L200.9 66.8L196.1 68.4L197.7 73.1L191.3 69.9L196.1 68.4Z" opacity="0.74"/>
          </g>

          <!-- الكوكب -->
          <g clip-path="url(#pm-globe)">
            <circle cx="100" cy="100" r="54" fill="url(#pm-body)"/>
            <!-- الأحزمة متموّجة بالـturbulence ومموّهة عشان تتداخل -->
            <g filter="url(#pm-bands)" opacity=".62">
              <rect x="40" y="56"  width="120" height="14" fill="#2A1712"/>
              <rect x="40" y="74"  width="120" height="9"  fill="#C2561B"/>
              <rect x="40" y="88"  width="120" height="17" fill="#2A1712"/>
              <rect x="40" y="110" width="120" height="12" fill="#E65100"/>
              <rect x="40" y="128" width="120" height="15" fill="#3E2723"/>
              <rect x="40" y="146" width="120" height="8"  fill="#BF360C"/>
            </g>
            <g filter="url(#pm-spot)">
              <ellipse cx="84" cy="116" rx="19" ry="9.5" fill="#E65100" opacity=".95"/>
              <ellipse cx="84" cy="116" rx="11" ry="5"   fill="#FF7A2E" opacity=".75"/>
            </g>
            <!-- التظليل الكروي: النور من فوق شمال والظل بيتلف لتحت يمين -->
            <circle cx="100" cy="100" r="54" fill="url(#pm-shade)"/>
          </g>
          <!-- ضوء الحافة -->
          <circle cx="100" cy="100" r="53.2" fill="none"
                  stroke="url(#pm-rim)" stroke-width="1.8"/>

          <!-- النص القريب — قدام الكوكب -->
          <g fill="#E3D9D4">
            <path d="M191.0 67.2L196.5 66.3L194.2 69.5L197.4 71.7L191.9 72.7L194.2 69.5Z" opacity="0.98"/>
