---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import { projectItems } from '../../data/work';

export function getStaticPaths() {
  return projectItems.map((item, i) => ({
    params: { slug: item.slug },
    props: { item, next: projectItems[(i + 1) % projectItems.length] },
  }));
}

const { item, next } = Astro.props;

const loopsDir = path.join(process.cwd(), 'public', 'loops');
const loopFiles = new Set(fs.existsSync(loopsDir) ? fs.readdirSync(loopsDir) : []);
const mp4 = `${item.sectionId}-${item.slug}.mp4`;
const webm = `${item.sectionId}-${item.slug}.webm`;
const hasLoop = loopFiles.has(mp4) || loopFiles.has(webm);

const credits = [
  ['Client', item.client],
  ['Role', item.role],
  ['Year', item.year],
  ['Tools', item.tools],
] as const;
---

<Base title={`${item.title} — Planet Motion`}>
  <div class="frame" aria-hidden="true">
    <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
  </div>

  <div class="top">
    <a class="mono" href="/">← Planet Motion</a>
    <span class="mono sec">{item.section}</span>
  </div>

  <main class="wrap page" id="main">
    <!-- transition:name هو اللي بيخلي الكارت في الفراغ يتمدد لهنا:
         المتصفح بيعمل المورف بين العنصرين اللي ليهم نفس الاسم -->
    <div
      class="hero"
      style={`aspect-ratio:${item.ar}`}
      transition:name={`card-${item.slug}`}
    >
      {hasLoop && (
        <video
          class="hero-v" muted loop playsinline autoplay
          data-mp4={loopFiles.has(mp4) ? `/loops/${mp4}` : ''}
          data-webm={loopFiles.has(webm) ? `/loops/${webm}` : ''}
        ></video>
      )}
      <span class="ar mono">{item.ar.replace(/ /g, '')}</span>
      <span class="dur mono">{item.tc}</span>
    </div>

    <h1 data-reveal>
      <span class="line-mask"><span>{item.title}</span></span>
    </h1>

    <dl class="credits">
      {credits.map(([k, v]) => (
        <div><dt class="mono">{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>

    <div class="story" data-stagger>
      <section><h2 class="mono">Brief</h2><p dir="rtl">{item.brief}</p></section>
      <section><h2 class="mono">Approach</h2><p dir="rtl">{item.approach}</p></section>
      <section><h2 class="mono">Result</h2><p dir="rtl">{item.result}</p></section>
    </div>

    <a class="next" href={`/work/${next.slug}`}>
      <span class="mono">Next project</span>
      <strong>{next.title}</strong>
    </a>
  </main>
</Base>

<style>
  .frame {
    position: fixed; inset: var(--fi); z-index: 40; pointer-events: none;
    border: 1px solid rgba(215, 204, 200, .09);
  }
  .frame .c { position: absolute; width: 9px; height: 9px; }
  .frame .c::before, .frame .c::after { content: ''; position: absolute; background: rgba(215,204,200,.3); }
  .frame .c::before { width: 100%; height: 1px; }
  .frame .c::after { width: 1px; height: 100%; }
  .frame .tl { top: -1px; left: -1px; }
  .frame .tr { top: -1px; right: -1px; } .frame .tr::after { right: 0; }
  .frame .bl { bottom: -1px; left: -1px; } .frame .bl::before { bottom: 0; }
  .frame .br { bottom: -1px; right: -1px; } .frame .br::before { bottom: 0; } .frame .br::after { right: 0; }

  .top {
    position: fixed; z-index: 55; top: var(--fi);
    left: var(--fi); right: var(--fi);
    display: flex; justify-content: space-between; padding-top: 7px;
  }
  .top a { text-decoration: none; color: var(--text-dim); }
  .top a:hover { color: var(--accent); }

  .page { padding-block: calc(var(--fi) + 56px) var(--s-8); }

  .hero {
    position: relative; width: min(1100px, 100%);
    background: var(--surface-1); border: 1px solid var(--line);
    overflow: hidden;
  }
  .hero-v { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ar  { position: absolute; left: 10px;  bottom: 9px; }
  .dur { position: absolute; right: 10px; bottom: 9px; }

  h1 { font-size: var(--t-h1); margin-top: var(--s-5); }

  .credits {
    display: flex; flex-wrap: wrap; gap: var(--s-5);
    margin: var(--s-5) 0 var(--s-7);
    padding-top: var(--s-3); border-top: 1px solid var(--line);
  }
  .credits dt { margin-bottom: 4px; }
  .credits dd { margin: 0; font-size: .95rem; }

  .story { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--s-5); }
  .story h2 { margin-bottom: var(--s-3); }
  .story p { margin: 0; color: var(--text-dim); max-width: 42ch; }

  .next {
    display: flex; flex-direction: column; gap: 6px;
    margin-top: var(--s-8); padding-top: var(--s-4);
    border-top: 1px solid var(--line); text-decoration: none;
  }
  .next strong { font-family: var(--font-display); font-size: var(--t-h2); letter-spacing: -.03em; }
  .next:hover strong { color: var(--accent); }
</style>

<script>
  // الفيديو بيتحمّل بعد ما الصفحة تبان — مش معطّل لأول رسمة
  const init = () => {
    const v = document.querySelector<HTMLVideoElement>('.hero-v');
    if (!v || v.dataset.ready) return;
    v.dataset.ready = '1';
    for (const [src, type] of [[v.dataset.mp4, 'video/mp4'], [v.dataset.webm, 'video/webm']] as const) {
      if (!src) continue;
      const el = document.createElement('source');
      el.src = src; el.type = type; v.append(el);
    }
    v.load();
    v.play().catch(() => {});
  };
  document.addEventListener('astro:page-load', init);
</script>
